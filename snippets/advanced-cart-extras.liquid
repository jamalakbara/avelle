{% comment %}
  AVELLE ADVANCED CART EXTRAS

  Free shipping threshold:
  60000000 = IDR 600,000 in Shopify price units.

  If your free shipping threshold is IDR 500,000,
  change it to: 50000000
{% endcomment %}

{% assign free_shipping_threshold = 60000000 %}
{% assign cart_total = cart.total_price %}
{% assign remaining_amount = free_shipping_threshold | minus: cart_total %}

{% if free_shipping_threshold > 0 %}
  {% assign progress = cart_total | times: 100 | divided_by: free_shipping_threshold %}
  {% if progress > 100 %}
    {% assign progress = 100 %}
  {% endif %}
{% endif %}


{% if position == 'top' %}

  <div class="avelle-cart-extra avelle-cart-extra--top">

    <div class="avelle-cart-offer">
      Limited-time offer: complete your order today.
    </div>

    <div class="avelle-shipping-progress">

      {% if cart_total >= free_shipping_threshold %}

        <div class="avelle-shipping-progress__text">
          <strong>You've unlocked FREE shipping</strong>
          <span>Enjoy your order ♡</span>
        </div>

      {% else %}

        <div class="avelle-shipping-progress__text">
          <strong>FREE SHIPPING</strong>

          <span>
            You're
            <strong>{{ remaining_amount | money }}</strong>
            away from free shipping
          </span>
        </div>

      {% endif %}

      <div class="avelle-progress-track">
        <div
          class="avelle-progress-bar"
          style="width: {{ progress }}%;"
        ></div>
      </div>

    </div>

  </div>

{% endif %}


{% if position == 'bottom' %}

  <div class="avelle-cart-trust">

    <div class="avelle-cart-trust__item">
      <span class="avelle-trust-icon">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <rect x="5" y="10" width="14" height="10" rx="2"/>
          <path d="M8 10V7a4 4 0 0 1 8 0v3"/>
        </svg>
      </span>

      <span>Secure<br>payment</span>
    </div>


    <div class="avelle-cart-trust__item">
      <span class="avelle-trust-icon">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path d="M3 6h11v10H3z"/>
          <path d="M14 9h4l3 3v4h-7z"/>
          <circle cx="7" cy="18" r="2"/>
          <circle cx="18" cy="18" r="2"/>
        </svg>
      </span>

      <span>Fast<br>delivery</span>
    </div>


    <div class="avelle-cart-trust__item">
      <span class="avelle-trust-icon">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/>
        </svg>
      </span>

      <span>Easy<br>exchange</span>
    </div>

  </div>

{% endif %}


<style>

  {% comment %}
  AVELLE ADVANCED CART EXTRAS
{% endcomment %}

{% assign shipping_amount = free_shipping_amount | default: 500000 | plus: 0 %}
{% assign free_shipping_threshold = shipping_amount | times: 100 %}

{% assign cart_total = cart.total_price %}
{% assign remaining_amount = free_shipping_threshold | minus: cart_total %}

{% if free_shipping_threshold > 0 %}
  {% assign progress = cart_total | times: 100 | divided_by: free_shipping_threshold %}

  {% if progress > 100 %}
    {% assign progress = 100 %}
  {% endif %}
{% endif %}


{% if position == 'top' %}

  <div class="avelle-cart-extra avelle-cart-extra--top">

    {% if offer_enabled %}
      <div class="avelle-cart-offer">
        {{ offer_text }}
      </div>
    {% endif %}

    <div class="avelle-shipping-progress">

      {% if cart_total >= free_shipping_threshold %}

        <div class="avelle-shipping-progress__text">
          <strong>
            {{ free_shipping_success | default: "You've unlocked FREE shipping" }}
          </strong>
        </div>

      {% else %}

        <div class="avelle-shipping-progress__text">

          <strong>
            {{ free_shipping_title | default: 'FREE SHIPPING' }}
          </strong>

          {% assign formatted_remaining = remaining_amount | money %}

          <span>
            {{
              free_shipping_message
              | default: "You're [amount] away from free shipping"
              | replace: '[amount]', formatted_remaining
            }}
          </span>

        </div>

      {% endif %}

      <div class="avelle-progress-track">
        <div
          class="avelle-progress-bar"
          style="width: {{ progress }}%;"
        ></div>
      </div>

    </div>

  </div>

{% endif %}


{% if position == 'bottom' %}

  <div class="avelle-cart-trust">

    <div class="avelle-cart-trust__item">

      <span class="avelle-trust-icon">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <rect x="5" y="10" width="14" height="10" rx="2"/>
          <path d="M8 10V7a4 4 0 0 1 8 0v3"/>
        </svg>
      </span>

      <div class="avelle-cart-trust__copy">
        <strong>{{ trust_1_title | default: 'Secure payment' }}</strong>

        {% if trust_1_text != blank %}
          <span>{{ trust_1_text }}</span>
        {% endif %}
      </div>

    </div>


    <div class="avelle-cart-trust__item">

      <span class="avelle-trust-icon">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path d="M3 6h11v10H3z"/>
          <path d="M14 9h4l3 3v4h-7z"/>
          <circle cx="7" cy="18" r="2"/>
          <circle cx="18" cy="18" r="2"/>
        </svg>
      </span>

      <div class="avelle-cart-trust__copy">
        <strong>{{ trust_2_title | default: 'Fast delivery' }}</strong>

        {% if trust_2_text != blank %}
          <span>{{ trust_2_text }}</span>
        {% endif %}
      </div>

    </div>


    <div class="avelle-cart-trust__item">

      <span class="avelle-trust-icon">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/>
        </svg>
      </span>

      <div class="avelle-cart-trust__copy">
        <strong>{{ trust_3_title | default: 'Easy exchange' }}</strong>

        {% if trust_3_text != blank %}
          <span>{{ trust_3_text }}</span>
        {% endif %}
      </div>

    </div>

  </div>

{% endif %}
.avelle-cart-trust__copy {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.avelle-cart-trust__copy strong {
  font-size: 10px;
  font-weight: 500;
  line-height: 1.25;
}

.avelle-cart-trust__copy span {
  font-size: 8px;
  opacity: 0.6;
  line-height: 1.25;
}
</style>