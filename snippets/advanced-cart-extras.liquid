{% comment %}
  AVELLE ADVANCED CART EXTRAS

  Positions used:
  - top     = offer bar + reward progress
  - offers  = public voucher / offer cards near cart summary
  - bottom  = trust messages

  Note:
  Shopify storefront Liquid cannot automatically list every active Admin discount code.
  Public offers shown here are controlled from Theme Editor.
  The normal Shopify discount input remains available for customer-specific codes.
{% endcomment %}

{% assign cart_subtotal = cart.original_total_price | default: cart.total_price %}

{% assign active_country_code = selected_country_code | default: localization.country.iso_code | upcase %}
{% assign active_currency_code = selected_currency_code | default: localization.country.currency.iso_code | upcase %}

{% case active_country_code %}
  {% when 'ID' %}
    {% assign offer_enabled = true %}
    {% assign offer_text = market_id_offer_text %}
    {% assign reward_1_amount = market_id_reward_1_amount %}
    {% assign reward_1_text = market_id_reward_1_text %}
    {% assign reward_2_amount = market_id_reward_2_amount %}
    {% assign reward_2_text = market_id_reward_2_text %}
    {% assign reward_3_amount = market_id_reward_3_amount %}
    {% assign reward_3_text = market_id_reward_3_text %}
  {% when 'SG' %}
    {% assign offer_enabled = true %}
    {% assign offer_text = market_sg_offer_text %}
    {% assign reward_1_amount = market_sg_reward_1_amount %}
    {% assign reward_1_text = market_sg_reward_1_text %}
    {% assign reward_2_amount = market_sg_reward_2_amount %}
    {% assign reward_2_text = market_sg_reward_2_text %}
    {% assign reward_3_amount = market_sg_reward_3_amount %}
    {% assign reward_3_text = market_sg_reward_3_text %}
  {% when 'MY' %}
    {% assign offer_enabled = true %}
    {% assign offer_text = market_my_offer_text %}
    {% assign reward_1_amount = market_my_reward_1_amount %}
    {% assign reward_1_text = market_my_reward_1_text %}
    {% assign reward_2_amount = market_my_reward_2_amount %}
    {% assign reward_2_text = market_my_reward_2_text %}
    {% assign reward_3_amount = market_my_reward_3_amount %}
    {% assign reward_3_text = market_my_reward_3_text %}
  {% else %}
    {% assign offer_enabled = true %}
    {% assign offer_text = market_int_offer_text %}
    {% assign reward_1_amount = market_int_reward_1_amount %}
    {% assign reward_1_text = market_int_reward_1_text %}
    {% assign reward_2_amount = market_int_reward_2_amount %}
    {% assign reward_2_text = market_int_reward_2_text %}
    {% assign reward_3_amount = market_int_reward_3_amount %}
    {% assign reward_3_text = market_int_reward_3_text %}
{% endcase %}

{% assign reward_1_icon = reward_1_icon | default: 'tag' %}
{% assign reward_2_icon = reward_2_icon | default: 'tag' %}
{% assign reward_3_icon = reward_3_icon | default: 'truck' %}

{% assign reward_1_value = reward_1_amount | default: 200000 | plus: 0 %}
{% assign reward_2_value = reward_2_amount | default: 800000 | plus: 0 %}
{% assign reward_3_value = reward_3_amount | default: 2000000 | plus: 0 %}

{% assign reward_1_threshold = reward_1_value | times: 100 %}
{% assign reward_2_threshold = reward_2_value | times: 100 %}
{% assign reward_3_threshold = reward_3_value | times: 100 %}

{% assign reward_level = 0 %}
{% assign next_threshold = reward_1_threshold %}

{% if cart_subtotal >= reward_1_threshold %}
  {% assign reward_level = 1 %}
  {% assign next_threshold = reward_2_threshold %}
{% endif %}

{% if cart_subtotal >= reward_2_threshold %}
  {% assign reward_level = 2 %}
  {% assign next_threshold = reward_3_threshold %}
{% endif %}

{% if cart_subtotal >= reward_3_threshold %}
  {% assign reward_level = 3 %}
{% endif %}

{% if reward_level < 3 %}
  {% assign remaining_amount = next_threshold | minus: cart_subtotal %}
  {% if remaining_amount < 0 %}{% assign remaining_amount = 0 %}{% endif %}
{% endif %}

{% if reward_3_threshold > 0 %}
  {% assign progress = cart_subtotal | times: 100.0 | divided_by: reward_3_threshold %}
{% else %}
  {% assign progress = 0 %}
{% endif %}
{% if progress > 100 %}{% assign progress = 100 %}{% endif %}
{% if progress < 0 %}{% assign progress = 0 %}{% endif %}

{% if reward_spacing == 'even' %}
  {% assign reward_1_position = 0 %}
  {% assign reward_2_position = 50 %}
  {% assign reward_3_position = 100 %}
{% else %}
  {% if reward_3_threshold > 0 %}
    {% assign reward_1_position = reward_1_threshold | times: 100.0 | divided_by: reward_3_threshold %}
    {% assign reward_2_position = reward_2_threshold | times: 100.0 | divided_by: reward_3_threshold %}
  {% else %}
    {% assign reward_1_position = 0 %}
    {% assign reward_2_position = 50 %}
  {% endif %}
  {% assign reward_3_position = 100 %}
{% endif %}

{% capture reward_icon_tag %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13l-7 7-9-9V4h7l9 9z"/><circle cx="8.5" cy="8.5" r="1.2"/></svg>{% endcapture %}
{% capture reward_icon_truck %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h11v10H3z"/><path d="M14 9h4l3 3v4h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg>{% endcapture %}
{% capture reward_icon_gift %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h16v10H4z"/><path d="M3 6h18v4H3z"/><path d="M12 6v14"/><path d="M12 6c-2.7 0-4.5-.8-4.5-2.2C7.5 2.7 8.4 2 9.5 2 11.2 2 12 4 12 6z"/><path d="M12 6c2.7 0 4.5-.8 4.5-2.2 0-1.1-.9-1.8-2-1.8C12.8 2 12 4 12 6z"/></svg>{% endcapture %}
{% capture reward_icon_star %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17.3l-5.6 2.9 1.1-6.2L3 9.6l6.2-.9L12 3z"/></svg>{% endcapture %}
{% capture reward_icon_check %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/></svg>{% endcapture %}

{% capture reward_1_icon_markup %}{% case reward_1_icon %}{% when 'truck' %}{{ reward_icon_truck }}{% when 'gift' %}{{ reward_icon_gift }}{% when 'star' %}{{ reward_icon_star }}{% when 'check' %}{{ reward_icon_check }}{% else %}{{ reward_icon_tag }}{% endcase %}{% endcapture %}
{% capture reward_2_icon_markup %}{% case reward_2_icon %}{% when 'truck' %}{{ reward_icon_truck }}{% when 'gift' %}{{ reward_icon_gift }}{% when 'star' %}{{ reward_icon_star }}{% when 'check' %}{{ reward_icon_check }}{% else %}{{ reward_icon_tag }}{% endcase %}{% endcapture %}
{% capture reward_3_icon_markup %}{% case reward_3_icon %}{% when 'tag' %}{{ reward_icon_tag }}{% when 'gift' %}{{ reward_icon_gift }}{% when 'star' %}{{ reward_icon_star }}{% when 'check' %}{{ reward_icon_check }}{% else %}{{ reward_icon_truck }}{% endcase %}{% endcapture %}

{% if position == 'top' %}
  <div class="avelle-cart-extra avelle-cart-extra--top">

    {% if offer_enabled and offer_text != blank %}
      <div class="avelle-cart-offer">
        {{ offer_text }}
      </div>
    {% endif %}

    {% if reward_enabled != false %}
    <div class="avelle-reward-progress">
      {% if reward_level == 0 %}
        {% assign remaining_money = remaining_amount | money %}
        <div class="avelle-reward-progress__message">
          {{ reward_next_prefix | default: 'Spend' }}
          <strong>{{ remaining_money }}</strong>
          {{ reward_next_middle | default: 'more to unlock' }}
          <strong>{{ reward_1_text }}</strong>
        </div>
      {% elsif reward_level == 1 %}
        {% assign remaining_money = remaining_amount | money %}
        <div class="avelle-reward-progress__message">
          <strong>✓ {{ reward_unlocked_prefix | default: "You've unlocked" }} {{ reward_1_text }}</strong>
        </div>
        <div class="avelle-reward-progress__next">
          {{ reward_next_prefix | default: 'Spend' }}
          <strong>{{ remaining_money }}</strong>
          {{ reward_next_middle | default: 'more to unlock' }}
          <strong>{{ reward_2_text }}</strong>
        </div>
      {% elsif reward_level == 2 %}
        {% assign remaining_money = remaining_amount | money %}
        <div class="avelle-reward-progress__message">
          <strong>✓ {{ reward_unlocked_prefix | default: "You've unlocked" }} {{ reward_2_text }}</strong>
        </div>
        <div class="avelle-reward-progress__next">
          {{ reward_next_prefix | default: 'Spend' }}
          <strong>{{ remaining_money }}</strong>
          {{ reward_next_middle | default: 'more to unlock' }}
          <strong>{{ reward_3_text }}</strong>
        </div>
      {% else %}
        <div class="avelle-reward-progress__message">
          <strong>✓ {{ reward_all_unlocked_message | default: 'All rewards unlocked!' }}</strong>
        </div>
      {% endif %}

      <div class="avelle-progress-track" aria-hidden="true">
        <div class="avelle-progress-bar" style="width: {{ progress }}%;"></div>
      </div>

      <div class="avelle-reward-milestones">
        <div class="avelle-reward-milestone{% if cart_subtotal >= reward_1_threshold %} is-unlocked{% endif %}" style="left: {{ reward_1_position }}%;">
          <span class="avelle-reward-milestone__icon">{{ reward_1_icon_markup }}</span>
          {% if reward_show_thresholds %}<span class="avelle-reward-milestone__amount">{{ reward_1_threshold | money_without_trailing_zeros }}</span>{% endif %}
          <span class="avelle-reward-milestone__label">{{ reward_1_text }}</span>
        </div>

        <div class="avelle-reward-milestone{% if cart_subtotal >= reward_2_threshold %} is-unlocked{% endif %}" style="left: {{ reward_2_position }}%;">
          <span class="avelle-reward-milestone__icon">{{ reward_2_icon_markup }}</span>
          {% if reward_show_thresholds %}<span class="avelle-reward-milestone__amount">{{ reward_2_threshold | money_without_trailing_zeros }}</span>{% endif %}
          <span class="avelle-reward-milestone__label">{{ reward_2_text }}</span>
        </div>

        <div class="avelle-reward-milestone{% if cart_subtotal >= reward_3_threshold %} is-unlocked{% endif %}" style="left: {{ reward_3_position }}%;">
          <span class="avelle-reward-milestone__icon">{{ reward_3_icon_markup }}</span>
          {% if reward_show_thresholds %}<span class="avelle-reward-milestone__amount">{{ reward_3_threshold | money_without_trailing_zeros }}</span>{% endif %}
          <span class="avelle-reward-milestone__label">{{ reward_3_text }}</span>
        </div>
      </div>

    </div>
    {% endif %}
  </div>

  <style>
    .cart-drawer__header {
      min-height: 64px;
      padding: 20px 24px;
      border-bottom: 1px solid rgba(0, 0, 0, .08);
    }

    .cart-drawer__heading {
      font-size: 17px !important;
      font-weight: 600;
      letter-spacing: .02em;
    }

    .avelle-cart-offer {
      background: {{ offer_background | default: '#111111' }};
      color: {{ offer_text_color | default: '#FFFFFF' }};
      text-align: {{ offer_text_align | default: 'center' }};
      padding: {{ offer_padding_y | default: 10 }}px 18px;
      font-size: {{ offer_text_size_desktop | default: 11 }}px;
      line-height: 1.4;
      letter-spacing: .02em;
    }

    .avelle-reward-progress {
      padding: {{ reward_top_padding | default: 18 }}px 24px {{ reward_bottom_padding | default: 20 }}px;
      border-bottom: 1px solid rgba(0, 0, 0, .08);
      background: {{ reward_background | default: '#FFFFFF' }};
      color: {{ reward_text_color | default: '#121212' }};
    }

    .avelle-reward-progress__message {
      font-size: 12px;
      line-height: 1.5;
      text-align: {{ reward_text_align | default: 'left' }};
    }

    .avelle-reward-progress__message strong {
      font-weight: 600;
    }

    .avelle-reward-progress__next {
      margin-top: 4px;
      font-size: 10px;
      line-height: 1.5;
      opacity: .65;
    }

    .avelle-reward-progress__next-inline {
      font-weight: 400;
      opacity: .62;
    }

    .avelle-progress-track {
      width: calc(100% - {{ reward_milestone_size | default: 28 }}px);
      margin-left: calc({{ reward_milestone_size | default: 28 }}px / 2);
      margin-right: calc({{ reward_milestone_size | default: 28 }}px / 2);
      height: {{ reward_bar_height | default: 5 }}px;
      margin-top: 18px;
      background: {{ reward_track_background | default: '#E2E3E4' }};
      overflow: visible;
    }

    .avelle-progress-bar {
      height: 100%;
      background: {{ reward_bar_fill | default: '#121212' }};
      transition: width .35s ease;
    }

    .avelle-reward-milestones {
      position: relative;
      width: calc(100% - {{ reward_milestone_size | default: 28 }}px);
      height: 72px;
      margin: 0 calc({{ reward_milestone_size | default: 28 }}px / 2);
    }

    .avelle-reward-milestone {
      position: absolute;
      top: calc(({{ reward_milestone_size | default: 28 }}px - {{ reward_bar_height | default: 5 }}px) / -2);
      width: 110px;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
      text-align: center;
      color: {{ reward_locked_color | default: '#8A8A8A' }};
      opacity: 1;
    }

    .avelle-reward-milestone:first-child {
      transform: translateX(0);
      align-items: flex-start;
      text-align: left;
    }

    .avelle-reward-milestone:last-child {
      transform: translateX(-100%);
      align-items: flex-end;
      text-align: right;
    }

    .avelle-reward-milestone__icon {
      width: {{ reward_milestone_size | default: 28 }}px;
      height: {{ reward_milestone_size | default: 28 }}px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: {{ reward_milestone_background | default: '#FFFFFF' }};
      border: 2px solid {{ reward_milestone_border | default: '#121212' }};
      color: currentColor;
    }

    .avelle-reward-milestone__icon svg {
      width: 14px;
      height: 14px;
    }

    .avelle-reward-milestone.is-unlocked {
      color: {{ reward_unlocked_color | default: '#121212' }};
    }

    .avelle-reward-milestone.is-unlocked .avelle-reward-milestone__icon {
      background: {{ reward_unlocked_color | default: '#121212' }};
      border-color: {{ reward_unlocked_color | default: '#121212' }};
      color: #fff;
    }

    .avelle-reward-milestone__amount {
      margin-top: 4px;
      font-size: {{ reward_tier_text_size_desktop | default: 8 }}px;
      font-weight: 600;
      line-height: 1.2;
    }

    .avelle-reward-milestone__label {
      max-width: 110px;
      font-size: {{ reward_tier_text_size_desktop | default: 8 }}px;
      line-height: 1.2;
    }

    .avelle-available-discounts {
      padding: 17px 24px;
      border-top: 1px solid rgba(0, 0, 0, .08);
      border-bottom: 1px solid rgba(0, 0, 0, .08);
      background: #fff;
    }

    .avelle-available-discounts__heading {
      margin-bottom: 7px;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: .06em;
    }

    .avelle-discount-offer {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 11px 0;
      border: 0;
      border-top: 1px solid rgba(0, 0, 0, .08);
      background: transparent;
      color: inherit;
      font: inherit;
      text-align: left;
      cursor: pointer;
    }

    .avelle-discount-offer:first-of-type {
      border-top: 0;
    }

    .avelle-discount-offer__copy {
      display: flex;
      flex-direction: column;
      gap: 2px;
      min-width: 0;
    }

    .avelle-discount-offer__copy strong {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: .04em;
    }

    .avelle-discount-offer__copy small {
      font-size: 9px;
      line-height: 1.4;
      opacity: .6;
    }

    .avelle-discount-offer__action {
      flex-shrink: 0;
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .cart-drawer__items {
      padding: 6px 24px 0;
    }

    .cart-items__table-row {
      padding: 18px 0 !important;
      margin: 0 !important;
      display: grid !important;
      grid-template-columns:
        {{ product_image_width_desktop | default: 82 }}px
        minmax(0, 1fr)
        auto !important;
      grid-template-areas:
        "media details quantity"
        "media details price"
        "media error error" !important;
      column-gap: 15px !important;
      row-gap: 5px !important;
      align-items: start !important;
      border-bottom: 1px solid rgba(0, 0, 0, .08);
    }

    .cart-items__media {
      grid-area: media !important;
    }

    .cart-items__details {
      grid-area: details !important;
      min-width: 0;
      font-size: 12px;
    }

    .cart-items__quantity {
      grid-area: quantity !important;
      margin: 0 !important;
      justify-self: end !important;
      align-self: start !important;
      width: auto !important;
    }

    .cart-items__price {
      grid-area: price !important;
      min-width: 0 !important;
      min-height: 0 !important;
      justify-self: end !important;
      align-self: start !important;
      text-align: right !important;
      font-size: 12px !important;
      font-weight: 500;
      white-space: nowrap;
    }

    .cart-items__media-container {
      width: {{ product_image_width_desktop | default: 82 }}px !important;
      aspect-ratio: 3 / 4 !important;
      display: flex !important;
      align-items: center;
      justify-content: center;
      border-radius: 3px;
      overflow: hidden;
      background: #f7f7f7;
    }

    .cart-items__media-image {
      width: 100% !important;
      height: 100% !important;
      max-width: 100% !important;
      max-height: 100% !important;
      object-fit: contain !important;
      object-position: center !important;
    }

    .cart-items__title {
      font-size: 13px !important;
      font-weight: 500;
      line-height: 1.35;
    }

    .cart-items__details * {
      font-size: 12px !important;
    }

    .cart-items__variants {
      margin-top: 5px !important;
      opacity: .65;
    }

    .cart-items__quantity-controls {
      gap: 3px !important;
      width: auto !important;
    }

    .cart-items__quantity .quantity-selector {
      min-height: {{ quantity_size_desktop | default: 30 }}px !important;
      height: {{ quantity_size_desktop | default: 30 }}px !important;
      font-size: 11px !important;
    }

    .cart-items__quantity .quantity-selector button,
    .cart-items__quantity .quantity-selector input,
    .cart-items__remove {
      width: {{ quantity_size_desktop | default: 30 }}px !important;
      min-width: {{ quantity_size_desktop | default: 30 }}px !important;
      height: {{ quantity_size_desktop | default: 30 }}px !important;
      min-height: {{ quantity_size_desktop | default: 30 }}px !important;
      padding: 0 !important;
    }

    .cart-items__quantity .quantity-selector input {
      text-align: center !important;
      font-size: 11px !important;
    }

    .cart-items__remove {
      opacity: .6;
    }

    .cart-items__remove:hover {
      opacity: 1;
    }

    .cart-drawer__summary {
      padding: 10px 24px 22px;
    }

    .cart__summary-totals {
      gap: 18px !important;
    }

    .cart-actions {
      border-color: rgba(0, 0, 0, .08) !important;
    }

    .cart-discount__summary {
      min-height: 48px;
    }

    .cart-discount__label {
      font-size: 12px !important;
      font-weight: 500;
    }

    .cart-discount__input {
      min-width: 0;
      border: 1px solid rgba(0, 0, 0, .18) !important;
      border-radius: 8px !important;
      padding: 11px 14px !important;
      font-size: 12px !important;
    }

    .cart-discount__button {
      min-width: 78px;
      border-radius: 8px !important;
      padding-inline: 16px !important;
      font-size: 11px !important;
      font-weight: 600;
      text-transform: none;
      letter-spacing: 0;
    }

    .cart-discount__form {
      gap: 8px !important;
    }

    .cart-discount__codes {
      margin-top: 8px !important;
    }

    .cart-discount__pill {
      padding: 7px 10px !important;
      border: 1px solid rgba(0, 0, 0, .12);
      border-radius: 8px !important;
      background: #f6f6f6 !important;
    }

    .cart-discount__pill-code {
      font-size: 11px;
      line-height: 1;
    }

    .cart__total-label {
      font-size: 13px !important;
      font-weight: 400 !important;
    }

    .cart__total-value {
      font-size: 15px !important;
      font-weight: 600;
    }

    .tax-note {
      opacity: .65;
    }

    .cart__ctas {
      margin-top: 5px;
    }

    .cart__checkout-button {
      width: 100% !important;
      min-height: 52px !important;
      background: #111 !important;
      color: #fff !important;
      border: 1px solid #111 !important;
      border-radius: 0 !important;
      text-transform: uppercase;
      letter-spacing: .06em;
      font-size: 12px !important;
      font-weight: 500;
    }

    .cart__checkout-button:hover {
      opacity: .88;
    }

    .avelle-cart-trust {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      border-top: 1px solid rgba(0, 0, 0, .08);
      padding: 18px 24px 20px;
    }

    .avelle-cart-trust__item {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: 7px;
      min-width: 0;
      text-align: left;
    }

    .avelle-trust-icon {
      display: flex;
      flex-shrink: 0;
    }

    .avelle-trust-icon svg {
      width: {{ trust_icon_size_desktop | default: 18 }}px;
      height: {{ trust_icon_size_desktop | default: 18 }}px;
    }

    .avelle-cart-trust__copy {
      display: flex;
      flex-direction: column;
      gap: 2px;
      min-width: 0;
    }

    .avelle-cart-trust__copy strong {
      font-size: {{ trust_title_size_desktop | default: 9 }}px;
      font-weight: 500;
      line-height: 1.25;
    }

    .avelle-cart-trust__copy span {
      font-size: {{ trust_description_size_desktop | default: 8 }}px;
      line-height: 1.3;
      opacity: .6;
    }

    @media screen and (max-width: 749px) {
      .cart-drawer__dialog {
        width: 100vw !important;
        max-width: 100vw !important;
      }

      .cart-drawer__header {
        padding: 18px;
      }

      .cart-drawer__content {
        display: block !important;
        overflow-y: auto !important;
        overflow-x: hidden !important;
        overscroll-behavior: contain;
        padding-bottom: 30px !important;
      }

      .cart-drawer__dialog[cart-summary-sticky='true'] .cart-drawer__summary,
      .cart-drawer__dialog[cart-summary-sticky='false'] .cart-drawer__summary,
      .cart-drawer__summary,
      .cart__ctas,
      .avelle-cart-extra--top,
      .avelle-cart-offer,
      .avelle-reward-progress,
      .avelle-available-discounts,
      .avelle-cart-trust {
        position: static !important;
        inset: auto !important;
        top: auto !important;
        right: auto !important;
        bottom: auto !important;
        left: auto !important;
        z-index: auto !important;
        transform: none !important;
        box-shadow: none !important;
      }

      .avelle-cart-offer {
        font-size: {{ offer_text_size_mobile | default: 10 }}px;
      }

      .avelle-reward-progress {
        padding: {{ reward_top_padding | default: 18 }}px 18px {{ reward_bottom_padding | default: 20 }}px;
      }

      .avelle-reward-progress__message {
        font-size: 11px;
      }

      .avelle-reward-progress__next {
        font-size: 9px;
      }

      .avelle-reward-milestones {
        height: 68px;
      }

      .avelle-reward-milestone {
        width: 82px;
      }

      .avelle-reward-milestone__icon {
        width: 26px;
        height: 26px;
      }

      .avelle-reward-milestone__amount,
      .avelle-reward-milestone__label {
        font-size: {{ reward_tier_text_size_mobile | default: 7 }}px;
      }

      .cart-drawer__items {
        padding-inline: 18px;
      }

      .cart-items__table-row {
        grid-template-columns:
          {{ product_image_width_mobile | default: 74 }}px
          minmax(0, 1fr)
          auto !important;
        grid-template-areas:
          "media details quantity"
          "media details price"
          "media error error" !important;
        column-gap: 12px !important;
        row-gap: 4px !important;
      }

      .cart-items__media-container {
        width: {{ product_image_width_mobile | default: 74 }}px !important;
      }

      .cart-items__quantity .quantity-selector {
        min-height: {{ quantity_size_mobile | default: 28 }}px !important;
        height: {{ quantity_size_mobile | default: 28 }}px !important;
      }

      .cart-items__quantity .quantity-selector button,
      .cart-items__quantity .quantity-selector input,
      .cart-items__remove {
        width: {{ quantity_size_mobile | default: 28 }}px !important;
        min-width: {{ quantity_size_mobile | default: 28 }}px !important;
        height: {{ quantity_size_mobile | default: 28 }}px !important;
        min-height: {{ quantity_size_mobile | default: 28 }}px !important;
      }

      .cart-items__title {
        font-size: 12px !important;
      }

      .cart-items__details *,
      .cart-items__price {
        font-size: 11px !important;
      }

      .avelle-available-discounts {
        margin-top: 10px;
        padding: 18px;
      }

      .cart-drawer__summary {
        padding: 18px !important;
        margin: 0 !important;
        background: #fff !important;
        border: 0 !important;
      }

      .cart__ctas {
        margin-top: 12px !important;
      }

      .avelle-cart-trust {
        padding: 18px;
        gap: 8px;
      }

      .avelle-trust-icon svg {
        width: {{ trust_icon_size_mobile | default: 18 }}px;
        height: {{ trust_icon_size_mobile | default: 18 }}px;
      }

      .avelle-cart-trust__copy strong {
        font-size: {{ trust_title_size_mobile | default: 8 }}px;
      }

      .avelle-cart-trust__copy span {
        font-size: {{ trust_description_size_mobile | default: 7 }}px;
      }

    }
  </style>

  <script>
    (() => {
      if (window.avelleCartDiscountInit) return;
      window.avelleCartDiscountInit = true;

      document.addEventListener('click', function(event) {
        const button = event.target.closest('[data-avelle-discount]');
        if (!button) return;

        const drawer = button.closest('.cart-drawer');
        if (!drawer) return;

        const code = button.dataset.avelleDiscount;
        if (!code) return;

        const input = drawer.querySelector('#cart-discount');
        if (!input) return;

        const details = input.closest('details');
        if (details && !details.open) {
          details.open = true;
        }

        input.value = code;
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.dispatchEvent(new Event('change', { bubbles: true }));

        const form = input.closest('form');
        if (!form) return;

        if (typeof form.requestSubmit === 'function') {
          form.requestSubmit();
        } else {
          const submitButton = form.querySelector('[type="submit"]');
          if (submitButton) submitButton.click();
        }
      });
    })();
  </script>
{% endif %}


