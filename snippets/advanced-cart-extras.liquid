{% comment %}
  AVELLE ADVANCED CART EXTRAS

  Free shipping threshold:
  60000000 = IDR 600,000 in Shopify price units.

  If your free shipping threshold is IDR 500,000,
  change it to: 50000000
{% endcomment %}

{% assign free_shipping_threshold = 60000000 %}
{% assign cart_total = cart.total_price %}
{% assign remaining_amount = free_shipping_threshold | minus: cart_total %}

{% if free_shipping_threshold > 0 %}
  {% assign progress = cart_total | times: 100 | divided_by: free_shipping_threshold %}
  {% if progress > 100 %}
    {% assign progress = 100 %}
  {% endif %}
{% endif %}


{% if position == 'top' %}

  <div class="avelle-cart-extra avelle-cart-extra--top">

    <div class="avelle-cart-offer">
      Limited-time offer: complete your order today.
    </div>

    <div class="avelle-shipping-progress">

      {% if cart_total >= free_shipping_threshold %}

        <div class="avelle-shipping-progress__text">
          <strong>You've unlocked FREE shipping</strong>
          <span>Enjoy your order ♡</span>
        </div>

      {% else %}

        <div class="avelle-shipping-progress__text">
          <strong>FREE SHIPPING</strong>

          <span>
            You're
            <strong>{{ remaining_amount | money }}</strong>
            away from free shipping
          </span>
        </div>

      {% endif %}

      <div class="avelle-progress-track">
        <div
          class="avelle-progress-bar"
          style="width: {{ progress }}%;"
        ></div>
      </div>

    </div>

  </div>

{% endif %}


{% if position == 'bottom' %}

  <div class="avelle-cart-trust">

    <div class="avelle-cart-trust__item">
      <span class="avelle-trust-icon">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <rect x="5" y="10" width="14" height="10" rx="2"/>
          <path d="M8 10V7a4 4 0 0 1 8 0v3"/>
        </svg>
      </span>

      <span>Secure<br>payment</span>
    </div>


    <div class="avelle-cart-trust__item">
      <span class="avelle-trust-icon">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path d="M3 6h11v10H3z"/>
          <path d="M14 9h4l3 3v4h-7z"/>
          <circle cx="7" cy="18" r="2"/>
          <circle cx="18" cy="18" r="2"/>
        </svg>
      </span>

      <span>Fast<br>delivery</span>
    </div>


    <div class="avelle-cart-trust__item">
      <span class="avelle-trust-icon">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/>
        </svg>
      </span>

      <span>Easy<br>exchange</span>
    </div>

  </div>

{% endif %}


<style>

  /* ==============================
     AVELLE CART DRAWER
  ============================== */

  .cart-drawer__dialog {
    width: min(480px, 100vw) !important;
    max-width: 480px !important;
  }


  /* HEADER */

  .cart-drawer__header {
    min-height: 64px;
    padding: 20px 24px;
    border-bottom: 1px solid rgba(0,0,0,.08);
  }

  .cart-drawer__heading {
    font-size: 17px !important;
    letter-spacing: .02em;
    font-weight: 600;
  }


  /* OFFER BAR */

  .avelle-cart-offer {
    background: #111;
    color: #fff;
    text-align: center;
    padding: 10px 18px;
    font-size: 11px;
    letter-spacing: .02em;
  }


  /* SHIPPING */

  .avelle-shipping-progress {
    padding: 18px 24px 20px;
    border-bottom: 1px solid rgba(0,0,0,.08);
  }

  .avelle-shipping-progress__text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 12px;
  }

  .avelle-shipping-progress__text > strong {
    font-size: 11px;
    letter-spacing: .08em;
  }

  .avelle-progress-track {
    margin-top: 13px;
    width: 100%;
    height: 4px;
    background: #ececec;
    overflow: hidden;
  }

  .avelle-progress-bar {
    height: 100%;
    background: #111;
    transition: width .35s ease;
  }


  /* CART ITEM AREA */

  .cart-drawer__items {
    padding: 6px 24px 0;
  }

  .cart-items__table-row {
    padding: 18px 0 !important;
    margin: 0 !important;

    grid-template-columns:
      82px minmax(0,1fr) auto !important;

    grid-template-areas:
      "media details price"
      "media quantity price"
      "media error error" !important;

    column-gap: 15px !important;

    border-bottom:
      1px solid rgba(0,0,0,.08);
  }


  /* PRODUCT IMAGE */

  .cart-items__media-container {
    width: 82px !important;
    aspect-ratio: 3 / 4 !important;
    border-radius: 3px;
    overflow: hidden;
  }

  .cart-items__media-image {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
  }


  /* PRODUCT TITLE */

  .cart-items__title {
    font-size: 13px !important;
    font-weight: 500;
    line-height: 1.35;
  }

  .cart-items__details {
    font-size: 12px;
  }

  .cart-items__details * {
    font-size: 12px !important;
  }

  .cart-items__variants {
    margin-top: 5px !important;
    opacity: .65;
  }


  /* PRODUCT PRICE */

  .cart-items__price {
    font-size: 12px !important;
    font-weight: 500;
    white-space: nowrap;
  }


  /* QUANTITY */

  .cart-items__quantity {
    margin-top: 12px !important;
  }

  .cart-items__quantity-controls {
    gap: 4px !important;
  }

  .cart-items__quantity .quantity-selector {
    min-height: 34px;
  }


  /* DELETE */

  .cart-items__remove {
    width: 34px !important;
    height: 34px !important;
    opacity: .6;
  }

  .cart-items__remove:hover {
    opacity: 1;
  }


  /* SUMMARY */

  .cart-drawer__summary {
    padding: 10px 24px 22px;
  }

  .cart__summary-totals {
    gap: 18px !important;
  }


  /* DISCOUNT */

  .cart-actions {
    border-color: rgba(0,0,0,.08) !important;
  }

  .cart-discount__summary {
    min-height: 48px;
  }

  .cart-discount__label {
    font-size: 12px !important;
  }

  .cart-discount__input {
    border: 1px solid rgba(0,0,0,.18) !important;
    border-radius: 0 !important;
    font-size: 12px !important;
  }

  .cart-discount__button {
    border-radius: 0 !important;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .05em;
  }


  /* TOTAL */

  .cart__total {
    padding-top: 5px;
  }

  .cart__total-label {
    font-size: 13px !important;
  }

  .cart__total-value {
    font-size: 15px !important;
    font-weight: 600;
  }


  /* CHECKOUT */

  .cart__ctas {
    margin-top: 5px;
  }

  .cart__checkout-button {
    min-height: 52px !important;

    background: #111 !important;
    color: #fff !important;

    border-radius: 0 !important;

    text-transform: uppercase;
    letter-spacing: .06em;

    font-size: 12px !important;
    font-weight: 500;
  }

  .cart__checkout-button:hover {
    opacity: .88;
  }


  /* TRUST */

  .avelle-cart-trust {
    display: grid;
    grid-template-columns: repeat(3,1fr);

    border-top: 1px solid rgba(0,0,0,.08);

    padding: 18px 24px 20px;

    gap: 10px;
  }

  .avelle-cart-trust__item {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: 7px;

    font-size: 9px;
    line-height: 1.3;
    text-align: left;
  }

  .avelle-trust-icon {
    display: flex;
    flex-shrink: 0;
  }


  /* MOBILE */

  @media screen and (max-width: 749px) {

    .cart-drawer__dialog {
      width: 100vw !important;
      max-width: 100vw !important;
    }

    .cart-drawer__header {
      padding: 18px 18px;
    }

    .avelle-shipping-progress {
      padding: 16px 18px 18px;
    }

    .cart-drawer__items {
      padding-inline: 18px;
    }

    .cart-drawer__summary {
      padding-inline: 18px;
    }

    .avelle-cart-trust {
      padding-inline: 18px;
    }

    .cart-items__table-row {
      grid-template-columns:
        74px minmax(0,1fr) auto !important;
    }

    .cart-items__media-container {
      width: 74px !important;
    }

  }

</style>