<style>

/* Zodiak - Serif / Headings */
@font-face {
  font-family: 'Zodiak';
  src: url("{{ 'Zodiak-Light.woff2' | asset_url }}") format("woff2");
  font-weight: 300;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: 'Zodiak';
  src: url("{{ 'Zodiak-Regular.woff2' | asset_url }}") format("woff2");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: 'Zodiak';
  src: url("{{ 'Zodiak-Regular.woff2' | asset_url }}") format("woff2");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: 'Zodiak';
  src: url("{{ 'Zodiak-Bold.woff2' | asset_url }}") format("woff2");
  font-weight: 600;
  font-style: normal;
  font-display: swap;
}

@font-face {
