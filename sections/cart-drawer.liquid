{% comment %}
  AVELLE CART DRAWER
  Separate editor section so designers can edit cart parts independently.
{% endcomment %}

<script src="{{ 'cart-drawer.js' | asset_url }}" type="module" fetchpriority="low"></script>

{% liquid
  assign offer_block = section.blocks | where: 'type', 'offer_bar' | first
  assign reward_block = section.blocks | where: 'type', 'reward_bar' | first
  assign products_block = section.blocks | where: 'type', 'products' | first
  assign discount_block = section.blocks | where: 'type', 'discount' | first
  assign trust_block = section.blocks | where: 'type', 'trust' | first
%}

{% style %}
  @media screen and (min-width: 750px) {
    .cart-drawer__dialog {
      width: {{ section.settings.cart_drawer_width_desktop }}px !important;
      max-width: min({{ section.settings.cart_drawer_width_desktop }}px, 100vw) !important;
    }
  }

  .cart-drawer__dialog:not(.cart-drawer--empty) .cart-drawer__inner,
  .cart-drawer__dialog:not(.cart-drawer--empty) .cart-items-component {
    height: 100%;
    min-height: 0;
  }

  .cart-drawer__dialog:not(.cart-drawer--empty) .cart-items-component {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .cart-drawer__dialog:not(.cart-drawer--empty) .avelle-cart-fixed-header {
    flex: 0 0 auto;
    position: relative !important;
    z-index: 4;
    background: rgb(var(--color-background-rgb));
  }

  .cart-drawer__dialog:not(.cart-drawer--empty) .avelle-cart-layout {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
  }

  .cart-drawer__dialog:not(.cart-drawer--empty) .avelle-cart-scroll {
    min-height: 0 !important;
    overflow-y: auto !important;
    overflow-x: hidden !important;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 18px;
  }

  .cart-drawer__dialog:not(.cart-drawer--empty) .avelle-cart-scroll .cart-drawer__summary,
  .cart-drawer__dialog:not(.cart-drawer--empty) .avelle-cart-scroll .cart__summary-totals,
  .cart-drawer__dialog:not(.cart-drawer--empty) .avelle-cart-scroll .cart__ctas,
  .cart-drawer__dialog:not(.cart-drawer--empty) .avelle-cart-scroll .avelle-cart-extra,
  .cart-drawer__dialog:not(.cart-drawer--empty) .avelle-cart-scroll .avelle-cart-trust {
    position: static !important;
    inset: auto !important;
    transform: none !important;
  }

  .cart-drawer__dialog:not(.cart-drawer--empty) .avelle-cart-summary-scroll .cart__ctas {
    display: none !important;
  }

  .avelle-cart-fixed-checkout {
    position: relative;
    z-index: 6;
    flex: 0 0 auto;
    background: rgb(var(--color-background-rgb));
    border-top: 1px solid rgb(var(--color-border-rgb) / 0.7);
    padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
    box-shadow: 0 -8px 24px rgb(0 0 0 / 0.05);
  }

  .avelle-cart-fixed-checkout__button {
    width: 100%;
    min-height: 52px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-inline: 20px;
    background: #000;
    color: #fff;
    border: 1px solid #000;
    border-radius: 0;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .cart-drawer .cart-items__quantity-controls {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: flex-end !important;
    gap: 10px !important;
  }

  .cart-drawer .cart-items__quantity .quantity-selector {
    display: inline-grid !important;
    grid-template-columns:
      {{ products_block.settings.cart_quantity_size_desktop | default: 30 }}px
      {{ products_block.settings.cart_quantity_size_desktop | default: 30 }}px
      {{ products_block.settings.cart_quantity_size_desktop | default: 30 }}px;
    height: {{ products_block.settings.cart_quantity_size_desktop | default: 30 }}px !important;
    min-height: {{ products_block.settings.cart_quantity_size_desktop | default: 30 }}px !important;
    border: 0 !important;
    background: transparent !important;
  }

  .cart-drawer .cart-items__quantity .quantity-selector button,
  .cart-drawer .cart-items__quantity .quantity-selector input,
  .cart-drawer .cart-items__remove {
    width: {{ products_block.settings.cart_quantity_size_desktop | default: 30 }}px !important;
    min-width: {{ products_block.settings.cart_quantity_size_desktop | default: 30 }}px !important;
    height: {{ products_block.settings.cart_quantity_size_desktop | default: 30 }}px !important;
    min-height: {{ products_block.settings.cart_quantity_size_desktop | default: 30 }}px !important;
    padding: 0 !important;
  }

  .cart-drawer .cart-items__media {
    width: {{ products_block.settings.cart_product_image_width_desktop | default: 82 }}px !important;
  }

  .cart-drawer .cart-items__media-container {
    width: {{ products_block.settings.cart_product_image_width_desktop | default: 82 }}px !important;
    height: calc({{ products_block.settings.cart_product_image_width_desktop | default: 82 }}px * 1.3333) !important;
  }

  @media screen and (max-width: 749px) {
    .cart-drawer .cart-items__quantity .quantity-selector {
      grid-template-columns:
        {{ products_block.settings.cart_quantity_size_mobile | default: 28 }}px
        {{ products_block.settings.cart_quantity_size_mobile | default: 28 }}px
        {{ products_block.settings.cart_quantity_size_mobile | default: 28 }}px;
      height: {{ products_block.settings.cart_quantity_size_mobile | default: 28 }}px !important;
      min-height: {{ products_block.settings.cart_quantity_size_mobile | default: 28 }}px !important;
    }

    .cart-drawer .cart-items__quantity .quantity-selector button,
    .cart-drawer .cart-items__quantity .quantity-selector input,
    .cart-drawer .cart-items__remove {
      width: {{ products_block.settings.cart_quantity_size_mobile | default: 28 }}px !important;
      min-width: {{ products_block.settings.cart_quantity_size_mobile | default: 28 }}px !important;
      height: {{ products_block.settings.cart_quantity_size_mobile | default: 28 }}px !important;
      min-height: {{ products_block.settings.cart_quantity_size_mobile | default: 28 }}px !important;
    }

    .cart-drawer .cart-items__media {
      width: {{ products_block.settings.cart_product_image_width_mobile | default: 74 }}px !important;
    }

    .cart-drawer .cart-items__media-container {
      width: {{ products_block.settings.cart_product_image_width_mobile | default: 74 }}px !important;
      height: calc({{ products_block.settings.cart_product_image_width_mobile | default: 74 }}px * 1.3333) !important;
    }
  }
{% endstyle %}

{% capture empty_cart_drawer_content %}
  <div class="cart-drawer__header">
    <button
      ref="closeButton"
      on:click="cart-drawer-component/close"
      class="button close-button cart-drawer__close-button button-unstyled"
      aria-label="{{ 'actions.close' | t }}"
    >
      <span class="svg-wrapper">{{- 'icon-close.svg' | inline_asset_content -}}</span>
    </button>
  </div>
  <div class="cart-drawer__content" aria-label="{{ 'content.cart_title' | t }}">
    <h2 class="cart-drawer__heading h4 cart-drawer__heading--empty">{{ 'content.your_cart_is_empty' | t }}</h2>
    <div class="cart-drawer__items">{% render 'cart-products', force_empty: true %}</div>
  </div>
{% endcapture %}

<cart-drawer-component
  class="cart-drawer"
  {% if settings.auto_open_cart_drawer %}auto-open{% endif %}
>
  <button
    type="button"
    hidden
    data-avelle-cart-drawer-internal-open
    on:click="/open"
    aria-hidden="true"
    tabindex="-1"
  ></button>

  <template id="empty-cart-template">{{ empty_cart_drawer_content }}</template>

  <dialog
    ref="dialog"
    class="cart-drawer__dialog dialog-modal dialog-drawer color-{{ settings.drawer_color_scheme }}{% if cart.empty? %} cart-drawer--empty{% endif %}"
    aria-labelledby="cart-drawer-heading"
    scroll-lock
    cart-summary-sticky="false"
  >
    <div class="cart-drawer__inner" data-hydration-key="cart-drawer-inner">
      <cart-items-component class="cart-items-component" data-drawer data-section-id="{{ section.id }}">
        {% if cart.empty? %}
          {{ empty_cart_drawer_content }}
        {% else %}
          <div class="cart-drawer__header avelle-cart-fixed-header">
            <h2 class="cart-drawer__heading h4" id="cart-drawer-heading">
              {{ 'content.cart_title' | t }} <span class="avelle-cart-header-count">{{ cart.item_count }}</span>
            </h2>
            <button
              ref="closeButton"
              on:click="cart-drawer-component/close"
              class="button close-button cart-drawer__close-button button-unstyled"
              aria-label="{{ 'actions.close' | t }}"
            >
              <span class="svg-wrapper">{{- 'icon-close.svg' | inline_asset_content -}}</span>
            </button>
          </div>

          <div class="avelle-cart-layout">
            <scroll-hint class="cart-drawer__content avelle-cart-scroll" aria-label="{{ 'content.cart_title' | t }}">
              {% if offer_block %}
                {% render 'advanced-cart-extras',
                  position: 'top',
                  offer_enabled: offer_block.settings.cart_offer_enabled,
                  offer_text: offer_block.settings.cart_offer_text,
                  offer_text_size_desktop: offer_block.settings.cart_offer_text_size_desktop,
                  offer_text_size_mobile: offer_block.settings.cart_offer_text_size_mobile,
                  offer_background: offer_block.settings.cart_offer_background,
                  offer_text_color: offer_block.settings.cart_offer_text_color,
                  offer_text_align: offer_block.settings.cart_offer_text_align,
                  offer_padding_y: offer_block.settings.cart_offer_padding_y,
                  reward_enabled: reward_block.settings.cart_reward_enabled,
                  reward_unlocked_prefix: reward_block.settings.cart_reward_unlocked_prefix,
                  reward_next_prefix: reward_block.settings.cart_reward_next_prefix,
                  reward_next_middle: reward_block.settings.cart_reward_next_middle,
                  reward_all_unlocked_message: reward_block.settings.cart_reward_all_unlocked_message,
                  reward_text_align: reward_block.settings.cart_reward_text_align,
                  reward_spacing: reward_block.settings.cart_reward_spacing,
                  reward_background: reward_block.settings.cart_reward_background,
                  reward_text_color: reward_block.settings.cart_reward_text_color,
                  reward_track_background: reward_block.settings.cart_reward_track_background,
                  reward_bar_fill: reward_block.settings.cart_reward_bar_fill,
                  reward_locked_color: reward_block.settings.cart_reward_locked_color,
                  reward_unlocked_color: reward_block.settings.cart_reward_unlocked_color,
                  reward_milestone_background: reward_block.settings.cart_reward_milestone_background,
                  reward_milestone_border: reward_block.settings.cart_reward_milestone_border,
                  reward_top_padding: reward_block.settings.cart_reward_top_padding,
                  reward_bottom_padding: reward_block.settings.cart_reward_bottom_padding,
                  reward_bar_height: reward_block.settings.cart_reward_bar_height,
                  reward_milestone_size: reward_block.settings.cart_reward_milestone_size,
                  reward_tier_text_size_desktop: reward_block.settings.cart_reward_tier_text_size_desktop,
                  reward_tier_text_size_mobile: reward_block.settings.cart_reward_tier_text_size_mobile,
                  reward_show_thresholds: reward_block.settings.cart_reward_show_thresholds,
                  reward_1_icon: reward_block.settings.cart_reward_1_icon,
                  reward_2_icon: reward_block.settings.cart_reward_2_icon,
                  reward_3_icon: reward_block.settings.cart_reward_3_icon,
                  selected_country_code: localization.country.iso_code,
                  selected_currency_code: localization.country.currency.iso_code,
                  market_id_reward_1_amount: reward_block.settings.market_id_reward_1_amount,
                  market_id_reward_1_text: reward_block.settings.market_id_reward_1_text,
                  market_id_reward_2_amount: reward_block.settings.market_id_reward_2_amount,
                  market_id_reward_2_text: reward_block.settings.market_id_reward_2_text,
                  market_id_reward_3_amount: reward_block.settings.market_id_reward_3_amount,
                  market_id_reward_3_text: reward_block.settings.market_id_reward_3_text,
                  market_id_offer_text: reward_block.settings.market_id_offer_text,
                  market_sg_reward_1_amount: reward_block.settings.market_sg_reward_1_amount,
                  market_sg_reward_1_text: reward_block.settings.market_sg_reward_1_text,
                  market_sg_reward_2_amount: reward_block.settings.market_sg_reward_2_amount,
                  market_sg_reward_2_text: reward_block.settings.market_sg_reward_2_text,
                  market_sg_reward_3_amount: reward_block.settings.market_sg_reward_3_amount,
                  market_sg_reward_3_text: reward_block.settings.market_sg_reward_3_text,
                  market_sg_offer_text: reward_block.settings.market_sg_offer_text,
                  market_my_reward_1_amount: reward_block.settings.market_my_reward_1_amount,
                  market_my_reward_1_text: reward_block.settings.market_my_reward_1_text,
                  market_my_reward_2_amount: reward_block.settings.market_my_reward_2_amount,
                  market_my_reward_2_text: reward_block.settings.market_my_reward_2_text,
                  market_my_reward_3_amount: reward_block.settings.market_my_reward_3_amount,
                  market_my_reward_3_text: reward_block.settings.market_my_reward_3_text,
                  market_my_offer_text: reward_block.settings.market_my_offer_text,
                  market_int_reward_1_amount: reward_block.settings.market_int_reward_1_amount,
                  market_int_reward_1_text: reward_block.settings.market_int_reward_1_text,
                  market_int_reward_2_amount: reward_block.settings.market_int_reward_2_amount,
                  market_int_reward_2_text: reward_block.settings.market_int_reward_2_text,
                  market_int_reward_3_amount: reward_block.settings.market_int_reward_3_amount,
                  market_int_reward_3_text: reward_block.settings.market_int_reward_3_text,
                  market_int_offer_text: reward_block.settings.market_int_offer_text,
                  trust_icon_size_desktop: trust_block.settings.cart_trust_icon_size_desktop,
                  trust_icon_size_mobile: trust_block.settings.cart_trust_icon_size_mobile,
                  trust_title_size_desktop: trust_block.settings.cart_trust_title_size_desktop,
                  trust_title_size_mobile: trust_block.settings.cart_trust_title_size_mobile,
                  trust_description_size_desktop: trust_block.settings.cart_trust_description_size_desktop,
                  trust_description_size_mobile: trust_block.settings.cart_trust_description_size_mobile,
                  quantity_size_desktop: products_block.settings.cart_quantity_size_desktop,
                  quantity_size_mobile: products_block.settings.cart_quantity_size_mobile,
                  product_image_width_desktop: products_block.settings.cart_product_image_width_desktop,
                  product_image_width_mobile: products_block.settings.cart_product_image_width_mobile
                %}
              {% endif %}

              <div class="cart-drawer__items">{% render 'cart-products' %}</div>

              {% if discount_block %}
                {% render 'advanced-cart-extras',
                  position: 'offers',
                  show_available_codes: discount_block.settings.cart_show_available_codes,
                  discount_heading: discount_block.settings.cart_discount_heading,
                  discount_code_1: discount_block.settings.cart_discount_code_1,
                  discount_code_1_text: discount_block.settings.cart_discount_code_1_text,
                  discount_code_2: discount_block.settings.cart_discount_code_2,
                  discount_code_2_text: discount_block.settings.cart_discount_code_2_text,
                  discount_code_3: discount_block.settings.cart_discount_code_3,
                  discount_code_3_text: discount_block.settings.cart_discount_code_3_text
                %}
              {% endif %}

              <div class="cart-drawer__summary avelle-cart-summary-scroll">
                {% render 'cart-summary', section_id: section.id %}
              </div>

              {% if trust_block %}
                {% render 'advanced-cart-extras',
                  position: 'bottom',
                  trust_1_icon: trust_block.settings.cart_trust_1_icon,
                  trust_2_icon: trust_block.settings.cart_trust_2_icon,
                  trust_3_icon: trust_block.settings.cart_trust_3_icon,
                  trust_icon_size_desktop: trust_block.settings.cart_trust_icon_size_desktop,
                  trust_icon_size_mobile: trust_block.settings.cart_trust_icon_size_mobile,
                  trust_title_size_desktop: trust_block.settings.cart_trust_title_size_desktop,
                  trust_title_size_mobile: trust_block.settings.cart_trust_title_size_mobile,
                  trust_description_size_desktop: trust_block.settings.cart_trust_description_size_desktop,
                  trust_description_size_mobile: trust_block.settings.cart_trust_description_size_mobile,
                  trust_1_title: trust_block.settings.cart_trust_1_title,
                  trust_1_text: trust_block.settings.cart_trust_1_text,
                  trust_2_title: trust_block.settings.cart_trust_2_title,
                  trust_2_text: trust_block.settings.cart_trust_2_text,
                  trust_3_title: trust_block.settings.cart_trust_3_title,
                  trust_3_text: trust_block.settings.cart_trust_3_text
                %}
              {% endif %}
            </scroll-hint>

            <div class="avelle-cart-fixed-checkout">
              <button type="submit" form="cart-form" name="checkout" class="button avelle-cart-fixed-checkout__button">
                <span>CHECK OUT</span>
                <span>{{ cart.total_price | money }}</span>
              </button>
            </div>
          </div>
        {% endif %}
      </cart-items-component>
    </div>
  </dialog>
</cart-drawer-component>

{% schema %}
{
  "name": "Cart drawer",
  "class": "avelle-cart-drawer-section",
  "settings": [
    {
      "type": "range",
      "id": "cart_drawer_width_desktop",
      "label": "Cart drawer width - desktop",
      "min": 400,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 520
    }
  ],
  "blocks": [
    {
      "type": "offer_bar",
      "name": "Offer bar",
      "settings": [
        {
          "type": "checkbox",
          "id": "cart_offer_enabled",
          "label": "Show offer bar",
          "default": true
        },
        {
          "type": "text",
          "id": "cart_offer_text",
          "label": "Offer bar text",
          "default": "Limited-time offer: complete your order today."
        },
        {
          "type": "range",
          "id": "cart_offer_text_size_desktop",
          "label": "Offer text size - desktop",
          "min": 7,
          "max": 30,
          "step": 1,
          "unit": "px",
          "default": 11
        },
        {
          "type": "range",
          "id": "cart_offer_text_size_mobile",
          "label": "Offer text size - mobile",
          "min": 7,
          "max": 30,
          "step": 1,
          "unit": "px",
          "default": 10
        },
        {
          "type": "color",
          "id": "cart_offer_background",
          "label": "Offer background",
          "default": "#111111"
        },
        {
          "type": "color",
          "id": "cart_offer_text_color",
          "label": "Offer text color",
          "default": "#FFFFFF"
        },
        {
          "type": "select",
          "id": "cart_offer_text_align",
          "label": "Offer text align",
          "default": "center",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ]
        },
        {
          "type": "range",
          "id": "cart_offer_padding_y",
          "label": "Offer vertical padding",
          "min": 4,
          "max": 30,
          "step": 1,
          "unit": "px",
          "default": 10
        }
      ]
    },
    {
      "type": "reward_bar",
      "name": "Reward bar",
      "settings": [
        {
          "type": "header",
          "content": "Reward bar"
        },
        {
          "type": "checkbox",
          "id": "cart_reward_enabled",
          "label": "Show reward bar",
          "default": true
        },
        {
          "type": "text",
          "id": "cart_reward_unlocked_prefix",
          "label": "Unlocked message",
          "default": "You've unlocked"
        },
        {
          "type": "text",
          "id": "cart_reward_next_prefix",
          "label": "Next reward message",
          "default": "Spend"
        },
        {
          "type": "text",
          "id": "cart_reward_next_middle",
          "label": "Next reward connector",
          "default": "more to unlock"
        },
        {
          "type": "text",
          "id": "cart_reward_all_unlocked_message",
          "label": "All rewards unlocked message",
          "default": "All rewards unlocked!"
        },
        {
          "type": "select",
          "id": "cart_reward_text_align",
          "label": "Reward message align",
          "default": "left",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ]
        },
        {
          "type": "header",
          "content": "Milestones"
        },
        {
          "type": "select",
          "id": "cart_reward_spacing",
          "label": "Milestone spacing",
          "default": "threshold",
          "options": [
            {
              "value": "threshold",
              "label": "Spaced by threshold"
            },
            {
              "value": "even",
              "label": "Evenly spaced"
            }
          ]
        },
        {
          "type": "select",
          "id": "cart_reward_1_icon",
          "label": "Reward 1 icon",
          "default": "tag",
          "options": [
            {
              "value": "tag",
              "label": "Discount tag"
            },
            {
              "value": "truck",
              "label": "Truck"
            },
            {
              "value": "gift",
              "label": "Gift"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "check",
              "label": "Check"
            }
          ]
        },
        {
          "type": "select",
          "id": "cart_reward_2_icon",
          "label": "Reward 2 icon",
          "default": "tag",
          "options": [
            {
              "value": "tag",
              "label": "Discount tag"
            },
            {
              "value": "truck",
              "label": "Truck"
            },
            {
              "value": "gift",
              "label": "Gift"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "check",
              "label": "Check"
            }
          ]
        },
        {
          "type": "select",
          "id": "cart_reward_3_icon",
          "label": "Reward 3 icon",
          "default": "truck",
          "options": [
            {
              "value": "tag",
              "label": "Discount tag"
            },
            {
              "value": "truck",
              "label": "Truck"
            },
            {
              "value": "gift",
              "label": "Gift"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "check",
              "label": "Check"
            }
          ]
        },
        {
          "type": "header",
          "content": "Indonesia"
        },
        {
          "type": "number",
          "id": "market_id_reward_1_amount",
          "label": "Indonesia reward 1 minimum",
          "default": 200000
        },
        {
          "type": "text",
          "id": "market_id_reward_1_text",
          "label": "Indonesia reward 1 label",
          "default": "Rp15.000 discount"
        },
