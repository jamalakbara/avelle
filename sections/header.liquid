{% comment %}
  Header Redesign
  Based on references/header.html with Tailwind CSS converted to custom CSS.
{% endcomment %}

{% schema %}
{
  "name": "t:names.header",
  "class": "header-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Configure up to 3 fixed reward milestones. Minimum spend remains market-specific below. Shopify theme settings can display rewards, but the real discount/free-shipping rule must also exist in Shopify Discounts."
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "t:sections.header.settings.menu.label"
    },
    {
      "type": "select",
      "id": "sticky_header_type",
      "options": [
        {
          "value": "none",
          "label": "t:sections.header.settings.sticky_header_type.options__1.label"
        },
        {
          "value": "on-scroll-up",
          "label": "t:sections.header.settings.sticky_header_type.options__2.label"
        },
        {
          "value": "always",
          "label": "t:sections.header.settings.sticky_header_type.options__3.label"
        }
      ],
      "default": "always",
      "label": "t:sections.header.settings.sticky_header_type.label"
    },
    {
      "type": "header",
      "content": "Sticky Header Overrides"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_header_product",
      "default": false,
      "label": "Enable sticky header on product page"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_header_collection",
      "default": false,
      "label": "Enable sticky header on collection page"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_header_cart",
      "default": false,
      "label": "Enable sticky header on cart page"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_header_search",
      "default": false,
      "label": "Enable sticky header on search page"
    },
    {
      "type": "checkbox",
      "id": "enable_transparent_header",
      "default": true,
      "label": "t:sections.header.settings.enable_transparent_header.label"
    },
    {
      "type": "checkbox",
      "id": "enable_transparent_header_product",
      "default": false,
      "label": "Enable transparent header on product page"
    },
    {
      "type": "checkbox",
      "id": "enable_transparent_header_collection",
      "default": true,
      "label": "Enable transparent header on collection page"
    },
    {
      "type": "checkbox",
      "id": "enable_transparent_header_page",
      "default": false,
      "label": "Enable transparent header on pages"
    },
    {
      "type": "checkbox",
      "id": "enable_transparent_header_search",
      "default": false,
      "label": "Enable transparent header on search page"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Scrolled State Override"
    },
    {
      "type": "color",
      "id": "scrolled_bg_color",
      "label": "Scrolled Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "scrolled_text_color",
      "label": "Scrolled Text Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Currency Switcher"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_currency_ui",
      "label": "Show country & currency selector",
      "info": "Uses Shopify Markets localization. The selected country controls the storefront market and currency.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_market_popup_first_visit",
      "label": "Show location popup on first visit",
      "default": true
    },
    {
      "type": "text",
      "id": "market_popup_heading",
      "label": "Location popup heading",
      "default": "Shopping preferences"
    },
    {
      "type": "textarea",
      "id": "market_popup_text",
      "label": "Location popup text",
      "default": "Choose where we’re shipping and your preferred display currency."
    },
    {
      "type": "text",
      "id": "market_popup_button_label",
      "label": "Location popup button",
      "default": "Update preferences"
    }
  ],
  "blocks": [
    {
      "type": "_header-logo"
    },
    {
      "type": "_header-menu"
    }
  ]
}
{% endschema %}

{%- liquid
  assign sticky_header_type = section.settings.sticky_header_type

  # Disable sticky header on specific pages unless explicitly enabled
  if template.name == 'product' and section.settings.enable_sticky_header_product == false
    assign sticky_header_type = 'none'
  elsif template.name == 'collection' and section.settings.enable_sticky_header_collection == false
    assign sticky_header_type = 'none'
  elsif template.name == 'list-collections' and section.settings.enable_sticky_header_collection == false
    assign sticky_header_type = 'none'
  elsif template.name == 'cart' and section.settings.enable_sticky_header_cart == false
    assign sticky_header_type = 'none'
  elsif template.name == 'search' and section.settings.enable_sticky_header_search == false
    assign sticky_header_type = 'none'
  endif

  assign transparent_header = false
  if template.name == 'index' and section.settings.enable_transparent_header
    assign transparent_header = true
  elsif template.name == 'product' and section.settings.enable_transparent_header_product
    assign transparent_header = true
  elsif template.name == 'collection' and section.settings.enable_transparent_header_collection
    assign transparent_header = true
  elsif template.name == 'list-collections' and section.settings.enable_transparent_header_collection
    assign transparent_header = true
  elsif template.name == 'page' and section.settings.enable_transparent_header_page
    assign transparent_header = true
  elsif template.name == 'search' and section.settings.enable_transparent_header_search
    assign transparent_header = true
  endif

  assign logo = settings.logo
  assign logo_height = settings.logo_height | default: 30
  assign logo_width = logo_height | times: logo.aspect_ratio | round
  assign logo_height_mobile = settings.logo_height_mobile | default: 20
  assign logo_width_mobile = logo_height_mobile | times: logo.aspect_ratio | round
-%}

{% style %}
  /* Custom Variables mapped from Reference Tailwind Config */
  .header-custom {
    --color-burgundy-100: #5d0f17;
    --color-off-white: #f2f0ed;
    --color-white: #ffffff;
    --color-dark-burgundy: #300000;
    --header-bg-color: var(--color-white);
    --header-text-color: #000000;

    --header-scrolled-bg: {{ section.settings.scrolled_bg_color }};
    --header-scrolled-text: {{ section.settings.scrolled_text_color }};

    --header-height: 70px;
    --header-padding: 15px; /* gap-xxs */
    --nav-btn-height: 35px;
    --nav-btn-min-width: 70px;
    --nav-btn-hover-width: 120px;

    --icon-stroke-width: 1.5px; /* Ensure icons are visible */
  }

  @media screen and (min-width: 768px) {
    .header-custom {
      --header-height: 80px; /* h-nav */
      --header-padding: 30px; /* px-md approx */
      --nav-btn-height: 40px;
    }
  }

  /* Sticky & Transparent Logic */

  /* Stick announcement bar + header together as one unit on every page.
     Both sections live inside #header-group (see layout/theme.liquid), so
     making the wrapper sticky keeps them locked together in normal flow:
     no overlap, no content jump. Keep the Header section's own
     "Sticky header type" = None so it doesn't switch to position:fixed and
     escape this wrapper. */
  #header-group {
    position: -webkit-sticky;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-custom.header-wrapper {
    position: relative;
    z-index: 100;
    width: 100%;
    transition: transform 0.3s ease, background-color 0.3s ease, color 0.3s ease, top 0.3s ease;
    background-color: var(--header-bg-color);
    color: var(--header-text-color);
    /* No will-change here: it creates a containing block that traps the
       position:fixed menu drawer inside the header, offsetting it below
       the announcement bar and pushing its bottom past the viewport. */
  }

  /* While the menu drawer is open, hide the floating WhatsApp button so it
     doesn't overlap the drawer's bottom links (e.g. the currency switcher). */
  body:has(.header-custom details.menu-open) #wa-chat-btn-root {
    display: none;
  }

  .header-custom.header-wrapper[data-sticky-type='on-scroll-up'] {
    position: fixed;
    top: 0;
    width: 100%;
    /* Let JS handle the translateY via inline style */
  }

  .header-custom.header-wrapper[data-sticky-type='always'] {
    position: sticky;
    top: 0;
  }

  .header-custom.header-wrapper.is-transparent {
    position: absolute;
    /* Fallback to 0, dynamically populated by JS to calculate precise offset of siblings like announcement bar */
    top: var(--announcement-bar-height, 0px);
    left: 0;
    right: 0;
    background: transparent;
    color: var(--color-white);
    border-bottom: none;
    transform: none !important; /* Force prevent any negative translations from JS */
  }

  .header-custom.header-wrapper.is-scrolled {
    background-color: var(--header-scrolled-bg) !important;
    color: var(--header-scrolled-text) !important;
    box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    /* Reduce height when scrolled */
    --header-height: 60px;
  }

  @media screen and (min-width: 768px) {
    .header-custom.header-wrapper.is-scrolled {
       --header-height: 65px;
    }
  }

  /* When transparent and on-scroll-up/always, we need absolute/fixed depending on scrolled state */
  /* OVERRIDES for sticky behavior */
  .header-custom.header-wrapper.is-scrolled[data-sticky-type='on-scroll-up'],
  .header-custom.header-wrapper.is-scrolled[data-sticky-type='always']  {
     position: fixed;
     top: 0 !important; /* Reset any top offsets when it becomes a sticky block */
  }

  .header-custom.header-wrapper.is-hidden {
     transform: translateY(-100%);
  }

  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0 var(--header-padding);
    height: var(--header-height);
    width: 100%;
    margin: 0 auto;
    max-width: var(--page-width, 1440px);
    transition: height 0.3s ease; /* Ensure smooth height transition */
  }

  /* Left: Menu Button */
  .header-left {
    display: flex;
    align-items: center;
    gap: 8px;
    z-index: 3;
  }

  /* Hide default details summary from header-drawer */
  .header-left header-drawer > details > summary {
    display: none !important;
  }

  .btn-header-pill {
    display: flex;
    align-items: center;
    justify-content: center; /* Center icon when text is hidden */
    height: var(--nav-btn-height);
    min-width: 44px; /* Sufficient for a circle/pill */
    padding: 0 4px; /* Reduced padding, text margin handles spacing */
    border-radius: 9999px;
    background-color: transparent;
    color: inherit;
    border: none;
    cursor: pointer;
    overflow: hidden;
    /* Remove fixed max-width on parent, animate children instead or allow auto growth */
    transition: all 0.3s ease;
    box-shadow: none;
    text-decoration: none;
  }

  /* Add padding when expanded to look nice */
  .btn-header-pill:hover {
    padding-right: 16px;
    padding-left: 12px;
  }

  /* Specific fix for anchor tags behaving as flex containers */
  a.btn-header-pill {
    box-sizing: border-box;
  }

  .btn-header-pill .icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px; /* Fixed width for icon container */
    height: 32px;
    flex-shrink: 0;
  }

  .btn-header-pill .icon-wrapper svg {
    width: 16px;
    height: 16px;
  }

  /* Inherit text color for icons */
  .btn-header-pill .icon-wrapper svg path,
  .btn-header-pill .icon-wrapper svg circle {
    stroke: currentColor !important;
  }

  .btn-header-pill .text {
    max-width: 0;
    opacity: 0;
    margin-left: 0;
    overflow: hidden;
    white-space: nowrap;
    transition: all 0.3s ease;
    font-size: 13px;
    font-family: 'Poppins', sans-serif; /* Added Poppins font */
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .btn-header-pill:hover .text {
    max-width: 100px; /* Arbitrary large number for text to fit */
    opacity: 1;
    margin-left: 4px;
  }

  @media screen and (max-width: 1023px) {
    .btn-header-pill:hover .text {
      max-width: 0;
      opacity: 0;
      margin-left: 0;
    }
  }

  /* Center: Logo */
  .header-center {
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1;
  }

  .header-logo-link {
    display: block;
    line-height: 1;
    color: inherit;
    text-decoration: none;
  }

  .header-logo-image {
    display: block;
    height: auto;
    object-fit: contain;
    width: {{ logo_width }}px;
    max-height: calc(var(--header-height) - 20px); /* Ensure logo shrinks if needed */
    filter: brightness(0) invert(1);
    transition: filter 0.3s ease, width 0.3s ease, max-height 0.3s ease;
  }

  .header-custom.header-wrapper:not(.is-transparent) .header-logo-image {
    filter: brightness(0);
  }

  .header-custom.header-wrapper.is-scrolled .header-logo-image {
    filter: brightness(0) !important;
  }

  @media screen and (max-width: 767px) {
    .header-logo-image {
      width: {{ logo_width_mobile }}px;
    }
  }

  .header-logo-text {
    text-transform: uppercase;
    font-size: 24px;
    font-weight: bold;
    letter-spacing: 0.05em;
    color: var(--color-white);
  }

  /* Right: Actions */
  .header-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    z-index: 2;
  }

  /* Cart Bubble Position Fix for Pill Button */
  .action-cart {
    position: relative;
  }

  /* Cart Bubble */
  .cart-count-bubble {
    position: absolute;
    background-color: var(--color-button);
    color: var(--color-button-text);
    height: 1.5rem;
    width: 1.5rem;
    border-radius: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 0.8rem;
    top: -5px;
    right: -10px;
    line-height: 1;
  }

  .action-cart {
    position: relative;
  }

  /* Mobile */
  @media screen and (max-width: 1023px) {
    .action-link span.visually-hidden-mobile {
      display: none;
    }
    .header-right {
      gap: 15px;
    }
    .action-account {
      display: none;
    }
    .action-favorite {
      display: none;
    }
  }

  /* Desktop Nav */
  .header-desktop-nav {
    display: none;
  }

  @media screen and (min-width: 1024px) {
    /* Hide hamburger on desktop */
    .header-left .btn-header-pill {
      display: none;
    }

    .header-desktop-nav {
      display: flex;
      align-items: center;
    }

    .header-desktop-nav > ul {
      display: flex;
      align-items: center;
      gap: 2px;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .header-desktop-nav > ul > li {
      position: relative;
    }

    .header-desktop-nav > ul > li > a {
      position: relative;
      display: flex;
      align-items: center;
      height: var(--nav-btn-height);
      padding: 0 9px;
      font-size: 12px;
      font-family: 'Poppins', sans-serif;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: inherit;
      text-decoration: none;
      white-space: nowrap;
      transition: opacity 0.25s ease;
    }

    /* Underline reveal — grows from center */
    .header-desktop-nav > ul > li > a::before {
      content: '';
      position: absolute;
      left: 50%;
      bottom: calc(var(--nav-btn-height) / 2 - 0.7em);
      width: 0;
      height: 1px;
      background-color: currentColor;
      opacity: 0.85;
      transform: translateX(-50%);
      transition: width 0.25s ease;
      pointer-events: none;
    }

    .header-desktop-nav > ul > li > a:hover::before,
    .header-desktop-nav > ul > li.is-active > a::before {
      width: calc(100% - 18px);
    }

    .header-desktop-nav > ul > li.has-dropdown > a::after {
      content: '';
      display: inline-block;
      width: 5px;
      height: 5px;
      border-right: 1.5px solid currentColor;
      border-bottom: 1.5px solid currentColor;
      transform: rotate(45deg) translateY(-2px);
      margin-left: 5px;
      opacity: 0.5;
      vertical-align: middle;
      flex-shrink: 0;
    }

    /* Dropdown */
    .header-desktop-nav .nav-dropdown {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      padding-top: 4px;
      min-width: 160px;
      background-color: #fff;
      border: 1px solid rgba(0, 0, 0, 0.08);
      border-radius: 8px;
      padding: 6px 0;
      list-style: none;
      margin: 0;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
      z-index: 200;
    }

    .header-desktop-nav .has-dropdown:hover .nav-dropdown {
      display: block;
    }

    .header-desktop-nav .nav-dropdown li a {
      display: block;
      padding: 8px 16px;
      font-size: 13px;
      font-family: 'Poppins', sans-serif;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: #000;
      text-decoration: none;
      white-space: nowrap;
      transition: background-color 0.15s ease;
    }

    .header-desktop-nav .nav-dropdown li a:hover {
      background-color: rgba(0, 0, 0, 0.04);
    }
  }

  /* WhatsApp floating button — move to right side */
  /* TODO: inspect live site for exact selector, then apply:
     [app-selector] { left: auto !important; right: 20px !important; }
  */

  @media screen and (max-width: 1023px) {
    .header-currency {
      display: none;
    }
  }

  /* Custom currency UI */
  .header-currency {
    position: relative;
  }

  .action-currency {
    gap: 4px;
  }

  .action-currency .currency-code {
    font-size: 13px;
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .action-currency .currency-caret {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 4px solid currentColor;
    flex-shrink: 0;
    margin-left: 2px;
  }

  .currency-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 4px);
    left: 50%;
    transform: translateX(-50%);
    min-width: 200px;
    background-color: #fff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    padding: 6px 0;
    list-style: none;
    margin: 0;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    z-index: 300;
    color: #333;
  }

  .currency-dropdown.open {
    display: block;
  }

  .currency-dropdown li {
    padding: 8px 16px;
    font-size: 13px;
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.15s ease;
  }

  .currency-dropdown li:hover {
    background-color: rgba(0, 0, 0, 0.04);
  }

  .currency-dropdown li.is-active {
    font-weight: 700;
  }

  /* Shopify Markets shipping destination + separate display currency */
  .action-market {
    gap: 5px;
    min-width: auto;
    padding-inline: 8px;
  }

  .action-market .market-current {
    font-size: 13px;
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    letter-spacing: .04em;
    white-space: nowrap;
  }

  .avelle-market-dialog {
    width: min(500px, calc(100vw - 32px));
    max-width: 500px;
    max-height: min(720px, calc(100vh - 40px));
    border: 0;
    padding: 0;
    background: #fff;
    color: #111;
    box-shadow: 0 24px 80px rgba(0,0,0,.18);
    overflow: visible;
  }

  .avelle-market-dialog::backdrop {
    background: rgba(0,0,0,.40);
  }

  .avelle-market-dialog__inner {
    padding: 30px;
  }

  .avelle-market-dialog__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 14px;
  }

  .avelle-market-dialog__title {
    margin: 0;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: .01em;
  }

  .avelle-market-dialog__close {
    width: 34px;
    height: 34px;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    display: grid;
    place-items: center;
    padding: 0;
    flex: 0 0 auto;
  }

  .avelle-market-dialog__text {
    margin: 0 0 24px;
    font-size: 13px;
    line-height: 1.6;
    opacity: .66;
  }

  .avelle-market-fields {
    display: grid;
    gap: 18px;
  }

  .avelle-market-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    position: relative;
  }

  .avelle-market-field label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .avelle-market-control {
    width: 100%;
    min-height: 50px;
    padding: 0 44px 0 14px;
    border: 1px solid rgba(0,0,0,.20);
    border-radius: 0;
    background: #fff;
    color: #111;
    font: inherit;
    font-size: 13px;
    text-align: left;
    cursor: pointer;
    position: relative;
  }

  .avelle-market-control::after {
    content: '';
    position: absolute;
    right: 16px;
    top: 50%;
    width: 7px;
    height: 7px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-65%) rotate(45deg);
  }

  .avelle-market-country-popover {
    display: none;
    position: absolute;
    z-index: 50;
    left: 0;
    right: 0;
    top: calc(100% + 6px);
    background: #fff;
    border: 1px solid rgba(0,0,0,.18);
    box-shadow: 0 14px 40px rgba(0,0,0,.12);
  }

  .avelle-market-country-popover.is-open {
    display: block;
  }

  .avelle-market-search-wrap {
    padding: 10px;
    border-bottom: 1px solid rgba(0,0,0,.10);
  }

  .avelle-market-search {
    width: 100%;
    min-height: 42px;
    padding: 0 12px;
    border: 1px solid rgba(0,0,0,.16);
    border-radius: 0;
    background: #fff;
    color: #111;
    font: inherit;
    font-size: 13px;
    outline: none;
  }

  .avelle-market-country-list {
    max-height: 280px;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 6px;
  }

  .avelle-market-country-option {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 11px 10px;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 13px;
    text-align: left;
    cursor: pointer;
  }

  .avelle-market-country-option:hover,
  .avelle-market-country-option.is-selected {
    background: rgba(0,0,0,.05);
  }

  .avelle-market-country-option__code {
    font-size: 11px;
    opacity: .55;
    flex: 0 0 auto;
  }

  .avelle-currency-select {
    width: 100%;
    min-height: 50px;
    padding: 0 44px 0 14px;
    border: 1px solid rgba(0,0,0,.20);
    border-radius: 0;
    background: #fff;
    color: #111;
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }

  .avelle-currency-select:disabled {
    opacity: .55;
    cursor: not-allowed;
  }

  .avelle-market-field-note {
    margin: 0;
    font-size: 10px;
    line-height: 1.5;
    opacity: .55;
  }

  .avelle-market-summary {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid rgba(0,0,0,.10);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .avelle-market-summary__item {
    min-width: 0;
  }

  .avelle-market-summary__label {
    display: block;
    margin-bottom: 4px;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: .06em;
    text-transform: uppercase;
    opacity: .55;
  }

  .avelle-market-summary__value {
    display: block;
    font-size: 12px;
    font-weight: 500;
  }

  .avelle-market-submit {
    width: 100%;
    min-height: 52px;
    margin-top: 22px;
    border: 1px solid #111;
    border-radius: 0;
    background: #111;
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .06em;
    text-transform: uppercase;
    cursor: pointer;
  }

  @media screen and (max-width: 749px) {
    .action-market .market-current {
      font-size: 11px;
    }

    .avelle-market-dialog {
      width: calc(100vw - 24px);
      max-width: none;
      max-height: calc(100vh - 24px);
    }

    .avelle-market-dialog__inner {
      padding: 24px 18px;
    }

    .avelle-market-country-list {
      max-height: 220px;
    }

    .avelle-market-summary {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }

{% endstyle %}


<header
  class="header-custom header-wrapper {% if transparent_header %}is-transparent{% endif %}"
  data-sticky-type="{{ sticky_header_type }}"
  data-template-name="{{ template.name }}"
  id="site-header"
>
  <div class="header-inner">
    <!-- LEFT -->
    <div class="header-left">
      {%- if section.settings.menu != blank -%}
        {% render 'header-drawer', linklist: section.settings.menu %}

        <button
          class="btn-header-pill group"
          onclick="const s = this.parentNode.querySelector('summary'); if(s) s.click()"
          aria-label="Menu"
        >
          <span class="icon-wrapper">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M1 3.5H13" stroke-width="1.5" stroke-linecap="round"/>
              <path d="M1 10.5H13" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </span>
          <span class="text">Menu</span>
        </button>

        <nav class="header-desktop-nav" aria-label="Main navigation">
          <ul>
            {%- for link in section.settings.menu.links -%}
              <li class="{% if link.links != blank %}has-dropdown{% endif %}{% if link.active or link.current %} is-active{% endif %}">
                <a href="{{ link.url }}">{{ link.title | escape }}</a>
                {%- if link.links != blank -%}
                  <ul class="nav-dropdown">
                    {%- for child_link in link.links -%}
                      <li><a href="{{ child_link.url }}">{{ child_link.title | escape }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    </div>

    <!-- CENTER -->
    <div class="header-center">
      <a href="{{ routes.root_url }}" class="header-logo-link">
        {%- if logo != blank -%}
          {%- assign image_size_2x = logo_width | times: 2 | at_most: 5760 -%}
          <img
            srcset="{{ logo | image_url: width: logo_width }} 1x, {{ logo | image_url: width: image_size_2x }} 2x"
            src="{{ logo | image_url: width: logo_width }}"
            loading="eager"
            width="{{ logo_width }}"
            height="{{ logo_height }}"
            alt="{{ logo.alt | default: shop.name | escape }}"
            class="header-logo-image"
          >
        {%- else -%}
          <span class="h2 header-logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    <!-- RIGHT -->
    <div class="header-right">
      {%- if section.settings.enable_custom_currency_ui -%}
        <div class="header-currency">
          <button
            type="button"
            class="btn-header-pill action-market"
            data-avelle-market-open
            aria-haspopup="dialog"
            aria-controls="avelle-market-dialog"
            aria-label="Change country or region"
          >
            <span class="market-current">
              {{ localization.country.iso_code }} · {{ localization.country.currency.iso_code }}
            </span>
            <span class="currency-caret" aria-hidden="true"></span>
          </button>
        </div>
      {%- endif -%}

      {%- if shop.customer_accounts_enabled -%}
        <a
          href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
          class="btn-header-pill action-account"
        >
          <span class="icon-wrapper">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M7 7C8.65685 7 10 5.65685 10 4C10 2.34315 8.65685 1 7 1C5.34315 1 4 2.34315 4 4C4 5.65685 5.34315 7 7 7Z" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M13 13C13 10.2386 10.3137 8 7 8C3.68629 8 1 10.2386 1 13" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="text">Sign In</span>
        </a>
      {%- endif -%}

      <button
        class="btn-header-pill action-search"
        onclick="const sm = document.getElementById('search-modal'); if(sm) sm.showDialog()"
        aria-label="{{ 'content.search' | t }}"
      >
        <span class="icon-wrapper">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="6" cy="6" r="4.5" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M12.5 12.5L9.5 9.5" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="text">Search</span>
      </button>

      <a href="/a/wishlist" class="btn-header-pill action-favorite" aria-label="Favorites">
        <span class="icon-wrapper">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M7 12C7 12 1 8.5 1 4.5C1 2.567 2.567 1 4.5 1C5.59 1 6.56 1.48 7 2.25C7.44 1.48 8.41 1 9.5 1C11.433 1 13 2.567 13 4.5C13 8.5 7 12 7 12Z" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
