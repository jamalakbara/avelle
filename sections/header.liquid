<script>
  (() => {
    const header = document.getElementById('site-header');
    if (!header) return;

    // Dynamically calculate the offset needed for transparent heading
    const setHeaderOffset = () => {
        const headerGroup = document.getElementById('header-group');
        if (headerGroup) {
            let offsetHeight = 0;
            const headerSection = header.closest('.shopify-section') || header;
            for (let child of headerGroup.children) {
                if (child === headerSection) break;
                offsetHeight += child.offsetHeight;
            }
            document.documentElement.style.setProperty('--announcement-bar-height', `${offsetHeight}px`);
            // Total height of the permanently-sticky header stack (announcement + header).
            // Consumed by sticky page content (e.g. product details column) so it
            // parks just below the pinned header instead of hiding behind it.
            document.documentElement.style.setProperty('--header-group-height', `${headerGroup.offsetHeight}px`);
        }
    };
    setHeaderOffset();
    window.addEventListener('resize', setHeaderOffset);

    // Sticky header logic
    const stickyType = header.dataset.stickyType;
    let lastScrollY = window.scrollY;
    let ticking = false;

    // Check initial transparency state
    const isInitiallyTransparent = {{ transparent_header | json }};

    const updateHeader = () => {
        const currentScrollY = window.scrollY;

        // Add solid background if scrolled more than 50px
        if (currentScrollY > 50) {
            header.classList.add('is-scrolled');
        } else {
            header.classList.remove('is-scrolled');
        }

        const isScrollingDown = currentScrollY > lastScrollY;
        const scrollDifference = Math.abs(currentScrollY - lastScrollY);

        // Sticky Logic - Hide/Show on scroll via class instead of inline transform
        // This is much safer and respects CSS specificity like !important rules
        if (stickyType === 'on-scroll-up') {
             if (isScrollingDown && currentScrollY > 150 && scrollDifference > 5) {
                 header.classList.add('is-hidden');
             } else if (!isScrollingDown && scrollDifference > 5) {
                 header.classList.remove('is-hidden');
             }
        } else if (stickyType === 'always') {
             header.classList.remove('is-hidden');
        }

        lastScrollY = currentScrollY;
        ticking = false;
    };

    // Run once on load to ensure initial state is correct
    updateHeader();

    const handleScroll = () => {
        if (!ticking) {
            window.requestAnimationFrame(updateHeader);
            ticking = true;
        }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    // Run once on load
    updateHeader();
  })();
</script>



<script>
  (() => {
    if (window.avelleExternalCartTriggerInit) return;
    window.avelleExternalCartTriggerInit = true;

    document.addEventListener('click', (event) => {
      const trigger = event.target.closest('[data-avelle-cart-open]');
      if (!trigger) return;

      const externalTrigger = document.querySelector('[data-avelle-cart-drawer-internal-open]');
      if (externalTrigger) {
        externalTrigger.click();
      } else {
        window.location.href = '{{ routes.cart_url }}';
      }
    });
  })();
</script>

{%- if section.settings.enable_custom_currency_ui -%}
<script>
  (() => {
    const dialog = document.getElementById('avelle-market-dialog');
    if (!dialog) return;

    const openButtons = document.querySelectorAll('[data-avelle-market-open]');
    const closeButton = dialog.querySelector('[data-avelle-market-close]');
    const localizationForm = dialog.querySelector('#AvelleMarketLocalizationForm');

    const countryCodeInput = dialog.querySelector('#AvelleCountryCode');
    const countryButton = dialog.querySelector('#AvelleCountryButton');
    const countryButtonText = dialog.querySelector('#AvelleCountryButtonText');
    const countryPopover = dialog.querySelector('#AvelleCountryPopover');
    const countrySearch = dialog.querySelector('#AvelleCountrySearch');
    const countryOptions = Array.from(dialog.querySelectorAll('.avelle-market-country-option'));

    const currencySelect = dialog.querySelector('#AvelleCurrencySelector');
    const currencyNote = dialog.querySelector('#AvelleCurrencyNote');
    const summaryCountry = dialog.querySelector('#AvelleSummaryCountry');
    const summaryCurrency = dialog.querySelector('#AvelleSummaryCurrency');

    const storageKey = 'avelle_market_selector_seen';
    const pendingCurrencyKey = 'avelle_pending_currency';

    const initialCountry = dialog.dataset.currentCountry;
    const initialCurrency = dialog.dataset.currentCurrency;

    const openDialog = () => {
      if (typeof dialog.showModal === 'function' && !dialog.open) {
        dialog.showModal();
      }
    };

    const closeCountryPopover = () => {
      countryPopover.classList.remove('is-open');
      countryPopover.hidden = true;
      countryButton.setAttribute('aria-expanded', 'false');
    };

    const openCountryPopover = () => {
      countryPopover.hidden = false;
      countryPopover.classList.add('is-open');
      countryButton.setAttribute('aria-expanded', 'true');
      window.setTimeout(() => countrySearch && countrySearch.focus(), 0);
    };

    const closeDialog = () => {
      closeCountryPopover();
      if (dialog.open) dialog.close();
    };

    openButtons.forEach(button => button.addEventListener('click', openDialog));
    if (closeButton) closeButton.addEventListener('click', closeDialog);

    dialog.addEventListener('click', event => {
      if (event.target === dialog) closeDialog();
    });

    countryButton.addEventListener('click', () => {
      countryPopover.hidden ? openCountryPopover() : closeCountryPopover();
    });

    countryOptions.forEach(option => {
      option.addEventListener('click', () => {
        const code = option.dataset.countryCode;
        const name = option.dataset.countryName;
        const suggestedCurrency = option.dataset.countryCurrency;

        countryCodeInput.value = code;
        countryButtonText.textContent = name;
        summaryCountry.textContent = name;

        countryOptions.forEach(item => item.classList.toggle('is-selected', item === option));
        closeCountryPopover();

        if (currencySelect.disabled && suggestedCurrency) {
          currencySelect.innerHTML = `<option value="${suggestedCurrency}">${suggestedCurrency}</option>`;
          currencySelect.value = suggestedCurrency;
          summaryCurrency.textContent = suggestedCurrency;
        }
      });
    });

    if (countrySearch) {
      countrySearch.addEventListener('input', () => {
        const query = countrySearch.value.trim().toLowerCase();
        countryOptions.forEach(option => {
          const haystack = `${option.dataset.countryName} ${option.dataset.countryCode}`.toLowerCase();
          option.hidden = query && !haystack.includes(query);
        });
      });
    }

    document.addEventListener('click', event => {
      if (!dialog.open) return;
      if (!countryPopover.contains(event.target) && event.target !== countryButton) {
        closeCountryPopover();
      }
    });

    const triggerNovaCurrency = (value, novaSelect) => {
      if (!value || !novaSelect) return false;

      const novaItem = document.querySelector(`.bacurr-dropdown-choices .currMovers[id="${CSS.escape(value)}"]`);
      if (novaItem) {
        novaItem.click();
        return true;
      }

      const hasOption = Array.from(novaSelect.options).some(opt => opt.value === value);
      if (hasOption) {
        novaSelect.value = value;
        novaSelect.dispatchEvent(new Event('change', { bubbles: true }));
        return true;
      }

      return false;
    };

    const buildCurrencySelector = novaSelect => {
      if (!novaSelect || !currencySelect) return;

      const seen = new Set();
      currencySelect.innerHTML = '';

      Array.from(novaSelect.options).forEach(option => {
        if (!option.value || seen.has(option.value)) return;
        seen.add(option.value);

        const item = document.createElement('option');
        item.value = option.value;
        item.textContent = option.textContent.trim() || option.value;
        if (option.selected || option.value === initialCurrency) item.selected = true;
        currencySelect.appendChild(item);
      });

      currencySelect.disabled = currencySelect.options.length <= 1;
      currencyNote.textContent = currencySelect.disabled
        ? 'Currency follows your selected Shopify Market.'
        : 'Choose how prices are displayed. Shipping destination stays unchanged.';

      summaryCurrency.textContent = currencySelect.value || initialCurrency;

      currencySelect.addEventListener('change', () => {
        summaryCurrency.textContent = currencySelect.value;
      });
    };

    const waitForNova = attempts => {
      const novaSelect = document.getElementById('baCurrSelector');

      if (novaSelect) {
        buildCurrencySelector(novaSelect);

        let pendingCurrency = null;
        try {
          pendingCurrency = sessionStorage.getItem(pendingCurrencyKey);
        } catch (e) {}

        if (pendingCurrency) {
          const applied = triggerNovaCurrency(pendingCurrency, novaSelect);
          if (applied) {
            try { sessionStorage.removeItem(pendingCurrencyKey); } catch (e) {}
          }
        }
        return;
      }

      if (attempts > 0) {
        window.setTimeout(() => waitForNova(attempts - 1), 300);
      } else {
        currencySelect.disabled = true;
        currencyNote.textContent = 'Currency currently follows your selected Shopify Market.';
      }
    };

    if (localizationForm) {
      localizationForm.addEventListener('submit', event => {
        const selectedCountry = countryCodeInput.value;
        const selectedCurrency = currencySelect.value || initialCurrency;
        const countryChanged = selectedCountry !== initialCountry;
        const novaSelect = document.getElementById('baCurrSelector');

        try { localStorage.setItem(storageKey, '1'); } catch (e) {}

        if (countryChanged) {
          try { sessionStorage.setItem(pendingCurrencyKey, selectedCurrency); } catch (e) {}
          return;
        }

        event.preventDefault();

        if (novaSelect && selectedCurrency !== initialCurrency) {
          const applied = triggerNovaCurrency(selectedCurrency, novaSelect);
          if (applied) {
            closeDialog();
            return;
          }
        }

        closeDialog();
      });
    }

    dialog.addEventListener('close', () => {
      try { localStorage.setItem(storageKey, '1'); } catch (e) {}
    });

    const showFirstVisit = dialog.dataset.firstVisit === 'true';
    if (showFirstVisit) {
      let seen = false;
      try { seen = localStorage.getItem(storageKey) === '1'; } catch (e) {}
      if (!seen) window.setTimeout(openDialog, 450);
    }

    waitForNova(25);
  })();
</script>
{%- endif -%}
