{% schema %}
{
  "name": "Cinematic Carousel Hero",
  "tag": "section",
  "class": "section-hero-carousel-cinematic",
  "settings": [
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay Speed",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation arrows",
      "default": false
    },
    {
      "type": "select",
      "id": "section_height_desktop",
      "label": "Section Height (Desktop)",
      "options": [
        { "value": "50vh", "label": "Small" },
        { "value": "85vh", "label": "Medium" },
        { "value": "100vh", "label": "Full Screen" }
      ],
      "default": "100vh"
    },
    {
      "type": "select",
      "id": "section_height_mobile",
      "label": "Section Height (Mobile)",
      "options": [
        { "value": "50vh", "label": "Small" },
        { "value": "85vh", "label": "Medium" },
        { "value": "100vh", "label": "Full Screen (100svh)" }
      ],
      "default": "100vh"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 20,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Heading Font Size (Mobile)",
      "default": 48
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "min": 40,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Heading Font Size (Desktop)",
      "default": 96
    },
    {
      "type": "range",
      "id": "subheading_size_mobile",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Subheading Font Size (Mobile)",
      "default": 18
    },
    {
      "type": "range",
      "id": "subheading_size_desktop",
      "min": 14,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Subheading Font Size (Desktop)",
      "default": 20
    },
    {
      "type": "range",
      "id": "button_font_size",
      "min": 7,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Button Font Size",
      "default": 9
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop Image",
          "info": "Recommended: 16:9 Landscape (e.g., 2880 x 1620px)"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Background Video (Optional)"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Image",
          "info": "Recommended: 9:16 Portrait (e.g., 1080 x 1920px)"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Elevate Your Every Day"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "Premium essentials for the modern lifestyle."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Shop Collection"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "select",
          "id": "text_color",
          "label": "Text Color Theme",
          "options": [
            { "value": "light", "label": "Light" },
            { "value": "dark", "label": "Dark" }
          ],
          "default": "light"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "label": "Overlay Opacity",
          "default": 30
        },
        {
          "type": "select",
          "id": "heading_font",
          "label": "Heading Font",
          "options": [
            { "value": "heading", "label": "Heading" },
            { "value": "body", "label": "Body" },
            { "value": "subheading", "label": "Subheading" },
            { "value": "accent", "label": "Accent" }
          ],
          "default": "heading"
        },
        {
          "type": "select",
          "id": "subheading_font",
          "label": "Subheading Font",
          "options": [
            { "value": "heading", "label": "Heading" },
            { "value": "body", "label": "Body" },
            { "value": "subheading", "label": "Subheading" },
            { "value": "accent", "label": "Accent" }
          ],
          "default": "subheading"
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "Content Position",
          "options": [
            { "value": "top", "label": "Top" },
            { "value": "center", "label": "Center" },
            { "value": "bottom", "label": "Bottom" }
          ],
          "default": "center"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cinematic Carousel Hero",
      "blocks": [{ "type": "slide" }, { "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}

<div
  class="hc-carousel"
  data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
  id="hc-carousel-{{ section.id }}"
  style="
    --hc-height-desktop: {{ section.settings.section_height_desktop }};
    --hc-height-mobile: {% if section.settings.section_height_mobile == '100vh' %}100svh{% else %}{{ section.settings.section_height_mobile }}{% endif %};
    --cbtn-font-size: {{ section.settings.button_font_size }}px;
  "
>
  <div class="hc-slides">
    {% for block in section.blocks %}
      {%- assign content_pos = '' -%}
      {%- case block.settings.content_position -%}
        {%- when 'top' -%}{%- assign align_v = 'flex-start' -%}
        {%- when 'bottom' -%}{%- assign align_v = 'flex-end' -%}{%- assign content_pos = 'bottom' -%}
        {%- else -%}{%- assign align_v = 'center' -%}
      {%- endcase -%}
      <div class="hc-slide" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
        {% comment %} Background Media {% endcomment %}
        <div class="hc-bg-wrapper">
          <div class="hc-bg">
            {% if block.settings.video != blank %}
              {{
                block.settings.video
                | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: 'hc-media'
              }}
            {% elsif block.settings.mobile_image != blank %}
              <picture class="hc-media-picture">
                <source media="(max-width: 767px)" srcset="{{ block.settings.mobile_image | image_url: width: 800 }}">
                <source media="(min-width: 768px)" srcset="{{ block.settings.image | image_url: width: 3000 }}">
                {{ block.settings.image | image_url: width: 3000 | image_tag: class: 'hc-media', loading: 'eager' }}
              </picture>
            {% elsif block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 3000 | image_tag: class: 'hc-media', loading: 'eager' }}
            {% else %}
              {{ 'lifestyle-' | append: forloop.index | placeholder_svg_tag: 'hc-media placeholder' }}
            {% endif %}
          </div>
        </div>

        {% comment %} Overlay {% endcomment %}
        <div
          class="hc-overlay"
          style="background: rgba(0,0,0,{{ block.settings.overlay_opacity | divided_by: 100.0 }});"
        ></div>

        {% comment %} Clickable image: link filled but no button label {% endcomment %}
        {% if block.settings.button_link != blank and block.settings.button_label == blank %}
          <a
            href="{{ block.settings.button_link }}"
            class="hc-slide-link"
            aria-label="{{ block.settings.heading | default: 'View slide' | escape }}"
          ></a>
        {% endif %}

        {% comment %} Content {% endcomment %}
        <div
          class="hc-content hc-theme-{{ block.settings.text_color }}{% if content_pos == 'bottom' %} hc-content--bottom{% endif %}"
          style="--hc-align-v: {{ align_v }}; --hc-heading-font: var(--font-{{ block.settings.heading_font }}--family); --hc-subheading-font: var(--font-{{ block.settings.subheading_font }}--family);"
        >
          <div class="hc-content-inner">
            <h2 class="hc-heading">
              <span class="hc-line-wrapper"
                ><span class="hc-line">{{ block.settings.heading }}</span></span
              >
            </h2>

            <div class="hc-subheading-wrapper">
              <p class="hc-subheading">
                {{ block.settings.subheading }}
              </p>
            </div>

            {% if block.settings.button_link != blank and block.settings.button_label != blank %}
              <div class="hc-btn-wrapper">
                <a href="{{ block.settings.button_link }}" class="hc-btn magnetic-btn cinematic-btn">
                  {{ block.settings.button_label }}
                </a>
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>

  {% comment %} UI: Progress Indicator & Hit Areas {% endcomment %}
  {% if section.blocks.size > 1 %}
    <div class="hc-ui">
      {% if section.settings.show_arrows %}
        <button class="hc-nav-btn hc-nav-prev" aria-label="Previous slide">
          <svg width="40" height="12" viewBox="0 0 40 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <line x1="40" y1="6" x2="1" y2="6" stroke="currentColor" stroke-width="1.5"/>
            <polyline points="8,1 1,6 8,11" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          </svg>
        </button>
      {% endif %}
      <div class="hc-dots" role="tablist" aria-label="Slides">
        {% for block in section.blocks %}
          <button
            type="button"
            class="hc-dot{% if forloop.first %} is-active{% endif %}"
            data-index="{{ forloop.index0 }}"
            aria-label="Go to slide {{ forloop.index }}"
            {% if forloop.first %}aria-current="true"{% endif %}
          >
            <span class="hc-dot-fill"></span>
          </button>
        {% endfor %}
      </div>
      {% if section.settings.show_arrows %}
        <button class="hc-nav-btn hc-nav-next" aria-label="Next slide">
          <svg width="40" height="12" viewBox="0 0 40 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <line x1="0" y1="6" x2="39" y2="6" stroke="currentColor" stroke-width="1.5"/>
            <polyline points="32,1 39,6 32,11" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          </svg>
        </button>
      {% endif %}
    </div>

    <!-- Navigation Hit Areas -->
    <div class="hc-hit-prev" data-dir="prev"></div>
    <div class="hc-hit-next" data-dir="next"></div>
  {% endif %}
</div>

<style>
  :root {
    --hc-heading-mobile: {{ section.settings.heading_size_mobile }}px;
    --hc-heading-desktop: {{ section.settings.heading_size_desktop }}px;
    --hc-subheading-mobile: {{ section.settings.subheading_size_mobile }}px;
    --hc-subheading-desktop: {{ section.settings.subheading_size_desktop }}px;
  }

  /* Carousel Base */
  .hc-carousel {
    position: relative;
    width: 100%;
    height: var(--hc-height-desktop);
    overflow: hidden;
    background: #000;
    cursor: pointer;
  }

  .hc-slides {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .hc-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    clip-path: inset(0 0 0 100%);
    z-index: 1;
    visibility: hidden;
    pointer-events: none; /* Let clicks pass through the slide container */
  }

  .hc-slide:first-child {
    clip-path: inset(0 0 0 0);
    z-index: 10; /* Must be higher than hit areas (z-index 5) */
    visibility: visible;
  }

  /* Background & Media */
  .hc-bg-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .hc-bg {
    width: 100%;
    height: 100%;
    transform-origin: center;
  }

  .hc-media,
  .hc-media-picture,
  .hc-media-picture img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hc-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  /* Clickable image (when slide has a link but no button label) */
  .hc-slide-link {
    position: absolute;
    inset: 0;
    z-index: 4; /* Above overlay/content, below progress UI */
    pointer-events: auto;
    cursor: pointer;
  }

  /* Content Overlay */
  .hc-content {
    position: absolute;
    inset: 0;
    z-index: 11; /* Above .hc-ui (10) so bottom button never hides behind the pill; pointer-events:none keeps hit areas clickable */
    display: flex;
    align-items: var(--hc-align-v, center);
    justify-content: var(--hc-align-h, center);
    pointer-events: none; /* Let clicks pass through to hit areas */
    padding: clamp(2rem, 6vh, 6rem) clamp(20px, 6vw, 6rem);
  }

  /* Bottom-position content: lift clear of the bottom-right slider-info cluster */
  .hc-content--bottom {
    padding-bottom: clamp(5rem, 9vh, 7rem);
  }

  .hc-content-inner {
    text-align: var(--hc-text-align, center);
    max-width: 900px;
    display: flex;
    flex-direction: column;
    align-items: var(--hc-align-h, center);
    gap: 1.5rem;
  }

  /* Theme Colors */
  .hc-theme-light {
    color: #fff;
  }
  .hc-theme-dark {
    color: #000;
  }

  /* Typography */
  .hc-heading {
    font-family: var(--hc-heading-font, inherit);
    font-size: clamp(var(--hc-heading-mobile), 8vw, var(--hc-heading-desktop));
    font-weight: 800;
    line-height: 1.1;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    color: inherit;
  }

  .hc-line-wrapper {
    display: block;
    overflow: hidden;
  }

  .hc-line {
    display: block;
    transform: translateY(100%); /* Initial state for GSAP */
    opacity: 0;
  }

  .hc-subheading-wrapper {
    overflow: hidden;
    margin: 0;
  }

  .hc-subheading {
    font-family: var(--hc-subheading-font, inherit);
    font-size: clamp(var(--hc-subheading-mobile, 16px), 2.5vw, var(--hc-subheading-desktop, 20px));
    font-weight: 300;
    margin: 0;
    opacity: 0; /* Initial state for GSAP */
    transform: translateY(100%);
    color: inherit;
  }

  /* Buttons */
  .hc-btn-wrapper {
    margin-top: 1rem;
    pointer-events: auto; /* Catch clicks for the button */
    position: relative;
    z-index: 20; /* Sit ABOVE hit-areas (5) */
    opacity: 0;
    transform: translateY(50px);
  }

  /* Hero CTA: solid white fill (overrides shared transparent .cinematic-btn).
     Hover keeps white fill — only lifts (transform + shadow inherited from base). */
  .hc-btn {
    background: #fff;
    color: #000;
    border-color: #fff;
  }
  .hc-btn:hover {
    background: #fff;
    color: #000;
    border-color: #fff;
  }

  /* Progress Bar UI */
  .hc-ui {
    position: absolute;
    bottom: 3rem;
    left: auto;
    right: 3rem;
    width: auto;
    padding: 0;
    gap: 1rem;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    color: #fff;
    mix-blend-mode: difference;
    pointer-events: none;
  }

  .hc-nav-btn {
    background: none;
    border: none;
    padding: 0;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    cursor: pointer;
    pointer-events: auto;
    opacity: 0.7;
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hc-nav-prev:hover {
    opacity: 1;
    transform: translateX(-4px);
  }

  .hc-nav-next:hover {
    opacity: 1;
    transform: translateX(4px);
  }

  .hc-dots {
    display: flex;
    align-items: center;
    gap: 10px;
    pointer-events: auto;
  }

  .hc-dot {
    position: relative;
    flex: none;
    width: 6px;
    height: 6px;
    padding: 0;
    border: none;
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.35);
    overflow: hidden;
    cursor: pointer;
    transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1), background 0.4s ease;
  }

  .hc-dot.is-active {
    width: 44px;
    background: rgba(255, 255, 255, 0.3);
  }

  .hc-dot-fill {
    position: absolute;
    inset: 0;
    background: #fff;
    border-radius: inherit;
    transform-origin: left;
    transform: scaleX(0);
  }

  /* Hit Areas */
  .hc-hit-prev,
  .hc-hit-next {
    position: absolute;
    top: 0;
    height: 100%;
    width: 50%;
    z-index: 5;
    pointer-events: auto;
  }
  .hc-hit-prev { left: 0; cursor: pointer; }
  .hc-hit-next { right: 0; cursor: pointer; }

  @media (max-width: 768px) {
    .hc-carousel { height: var(--hc-height-mobile); }
    .hc-hit-prev, .hc-hit-next { cursor: auto; }
    .hc-ui { mix-blend-mode: normal; bottom: 2rem; left: 0; right: 0; width: 100%; padding: 0 1.5rem; justify-content: center; }
    .hc-content--bottom { padding-bottom: clamp(4.5rem, 14vh, 6rem); }
    .hc-dot:not(.is-active) { background: rgba(255,255,255,0.5); }
    .hc-btn-wrapper { pointer-events: auto; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof gsap === 'undefined') {
      console.warn('GSAP is required for Cinematic Carousel Hero');
      return;
    }

    class CinematicCarousel {
      constructor(el) {
        this.el = el;
        this.slides = el.querySelectorAll('.hc-slide');
        if (this.slides.length < 2) {
          // If only 1 slide, just reveal text and exit
          if (this.slides.length === 1) this.revealText(0);
          return;
        }

        this.total = this.slides.length;
        this.currentIndex = 0;
        this.autoplaySpeed = parseInt(el.dataset.autoplaySpeed) || 5000;

        this.dots = el.querySelectorAll('.hc-dot');

        this.isAnimating = false;

        this.hitPrev = el.querySelector('.hc-hit-prev');
        this.hitNext = el.querySelector('.hc-hit-next');
        this.navPrev = el.querySelector('.hc-nav-prev');
        this.navNext = el.querySelector('.hc-nav-next');

        // Hide initial clips except first
        gsap.set(this.slides, { visibility: 'visible', zIndex: 1 });
        gsap.set(this.slides[0], { zIndex: 10 });

        this.init();
      }

      init() {
        // Initial text reveal for first slide
        this.revealText(0);

        // Start Autoplay
        this.startAutoplay();

        // Navigation Events
        if (this.hitPrev && this.hitNext) {
          this.hitPrev.addEventListener('click', () => this.navigate('prev'));
          this.hitNext.addEventListener('click', () => this.navigate('next'));
        }
        if (this.navPrev) this.navPrev.addEventListener('click', () => this.navigate('prev'));
        if (this.navNext) this.navNext.addEventListener('click', () => this.navigate('next'));

        // Direct navigation via dots
        this.dots.forEach((dot) => {
          dot.addEventListener('click', () => this.goTo(parseInt(dot.dataset.index, 10)));
        });
      }

      getFill(index) {
        const dot = this.dots && this.dots[index];
        return dot ? dot.querySelector('.hc-dot-fill') : null;
      }

      updateDots(index) {
        this.dots.forEach((dot, i) => {
          const active = i === index;
          dot.classList.toggle('is-active', active);
          if (active) {
            dot.setAttribute('aria-current', 'true');
          } else {
            dot.removeAttribute('aria-current');
            const fill = dot.querySelector('.hc-dot-fill');
            if (fill) gsap.set(fill, { scaleX: 0 });
          }
        });
      }

      revealText(index) {
        const slide = this.slides[index];
        const line = slide.querySelector('.hc-line');
        const sub = slide.querySelector('.hc-subheading');
        const btn = slide.querySelector('.hc-btn-wrapper');

        // Reset state before animating
        gsap.set([line, sub, btn], { y: 100, opacity: 0 });

        gsap.to([line, sub, btn], {
          y: 0,
          opacity: 1,
          duration: 1.2,
          stagger: 0.15,
          ease: 'power4.out',
          delay: 0.4, // wait for clip path to be partially revealed
        });
      }

      hideText(index) {
        const slide = this.slides[index];
        const line = slide.querySelector('.hc-line');
        const sub = slide.querySelector('.hc-subheading');
        const btn = slide.querySelector('.hc-btn-wrapper');

        gsap.to([line, sub, btn], {
          y: -50,
          opacity: 0,
          duration: 0.8,
          ease: 'power3.in',
        });
      }

      startAutoplay() {
        const fill = this.getFill(this.currentIndex);
        if (!fill) return;

        gsap.killTweensOf(fill);
        gsap.set(fill, { scaleX: 0 });

        gsap.to(fill, {
          scaleX: 1,
          duration: this.autoplaySpeed / 1000,
          ease: 'linear',
          onComplete: () => this.navigate('next'),
        });
      }

      navigate(dir) {
        const nextIndex =
          dir === 'next' ? (this.currentIndex + 1) % this.total : (this.currentIndex - 1 + this.total) % this.total;
        this.transitionTo(nextIndex, dir);
      }

      goTo(index) {
        if (index === this.currentIndex || Number.isNaN(index)) return;
        const dir = index > this.currentIndex ? 'next' : 'prev';
        this.transitionTo(index, dir);
      }

      transitionTo(nextIndex, dir) {
        if (this.isAnimating) return;
        this.isAnimating = true;

        const activeFill = this.getFill(this.currentIndex);
        if (activeFill) {
          gsap.killTweensOf(activeFill);
          gsap.set(activeFill, { scaleX: 0 });
        }

        const currentSlide = this.slides[this.currentIndex];
        const nextSlide = this.slides[nextIndex];

        const currentBg = currentSlide.querySelector('.hc-bg');
        const nextBg = nextSlide.querySelector('.hc-bg');

        // Stack management
        gsap.set(this.slides, { zIndex: 1 });
        gsap.set(currentSlide, { zIndex: 9 });
        gsap.set(nextSlide, { zIndex: 10 });

        // Determine clip-path direction
        // 'next' sweeps from right to left (starts with 100% clipped from left)
        const startClip = dir === 'next' ? 'inset(0% 0% 0% 100%)' : 'inset(0% 100% 0% 0%)';
        const endClip = 'inset(0% 0% 0% 0%)';

        // Prepare next slide
        gsap.set(nextSlide, { clipPath: startClip });
        gsap.set(nextBg, { scale: 1.15 });

        // Hide current text
        this.hideText(this.currentIndex);

        // Animate Clip Path
        gsap.to(nextSlide, {
          clipPath: endClip,
          duration: 1.4,
          ease: 'expo.inOut',
        });

        // Animate incoming background scale
        gsap.to(nextBg, {
          scale: 1,
          duration: 1.4,
          ease: 'expo.inOut',
        });

        // Animate outgoing background scale
        gsap.to(currentBg, {
          scale: 0.9,
          duration: 1.4,
          ease: 'expo.inOut',
        });

        // Reveal incoming text
        this.revealText(nextIndex);

        // Clean up and restart
        setTimeout(() => {
          this.currentIndex = nextIndex;
          this.updateDots(nextIndex);

          // Reset old slide
          gsap.set(currentSlide, { clipPath: 'inset(0 0 0 100%)' });
          gsap.set(currentBg, { scale: 1 });

          this.isAnimating = false;
          this.startAutoplay();
        }, 1400); // Wait for transition to finish
      }
    }

    document.querySelectorAll('.hc-carousel').forEach((el) => new CinematicCarousel(el));
  });
</script>
