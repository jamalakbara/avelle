<div
  class="section faq-content page-width-content color-{{ section.settings.color_scheme }}"
  style="
    padding-block-start: {{ section.settings['padding-block-start'] }}px;
    padding-block-end: {{ section.settings['padding-block-end'] }}px;
    --faq-group-gap: {{ section.settings.group_gap }}px;
    --faq-heading-font: var(--font-{{ section.settings.heading_font }}--family);
    --faq-heading-size: {{ section.settings.heading_size }}px;
    --faq-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --faq-heading-weight: {{ section.settings.heading_weight }};
    --faq-heading-case: {{ section.settings.heading_case }};
    --faq-heading-gap: {{ section.settings.heading_margin }}px;
    --faq-question-font: var(--font-{{ section.settings.question_font }}--family);
    --faq-question-size: {{ section.settings.question_size }}px;
    --faq-question-size-mobile: {{ section.settings.question_size_mobile }}px;
    --faq-question-weight: {{ section.settings.question_weight }};
    --faq-question-case: {{ section.settings.question_case }};
    --faq-answer-size: {{ section.settings.answer_size }}px;
    --faq-answer-size-mobile: {{ section.settings.answer_size_mobile }}px;
  "
>
  <template id="faq-source-{{ section.id }}">{{ page.content }}</template>
  <template id="faq-icons-{{ section.id }}">
    <span class="svg-wrapper icon-plus">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
    <span class="svg-wrapper icon-minus">{{- 'icon-minus.svg' | inline_asset_content -}}</span>
  </template>
  <div id="faq-output-{{ section.id }}"></div>
  <noscript>{{ page.content }}</noscript>
</div>

<script>
(function () {
  const id = '{{ section.id }}';

  function buildFaq() {
  const sourceEl = document.getElementById('faq-source-' + id);
  const iconsEl = document.getElementById('faq-icons-' + id);
  const output = document.getElementById('faq-output-' + id);
  if (!sourceEl || !output) return;

  output.innerHTML = '';

  const parser = new DOMParser();
  const doc = parser.parseFromString(sourceEl.innerHTML, 'text/html');
  const nodes = [...doc.body.children];

  const fragment = document.createDocumentFragment();
  let currentItems = null;
  let currentContent = null;
  let hasStructure = false;

  for (const node of nodes) {
    const tag = node.tagName.toLowerCase();
    const isHeading = /^h[1-6]$/.test(tag);
    const boldEls = [...node.querySelectorAll('strong, b')];
    const boldText = boldEls.map(el => el.textContent).join('').trim();
    const isQuestion = tag === 'p' && boldText.length > 0 && boldText === node.textContent.trim();

    if (isHeading) {
      hasStructure = true;

      const group = document.createElement('div');
      group.className = 'faq-group';

      const h = document.createElement('h3');
      h.className = 'faq-group__heading';
      h.textContent = node.textContent;

      currentItems = document.createElement('div');
      currentItems.className = 'accordion accordion--plus accordion--dividers';

      group.appendChild(h);
      group.appendChild(currentItems);
      fragment.appendChild(group);
      currentContent = null;

    } else if (isQuestion && currentItems) {
      const wrap = document.createElement('accordion-custom');
      const details = document.createElement('details');
      details.className = 'details';

      const summary = document.createElement('summary');
      summary.className = 'details__header';
      summary.textContent = node.textContent.trim();
      if (iconsEl) summary.appendChild(iconsEl.content.cloneNode(true));

      currentContent = document.createElement('div');
      currentContent.className = 'faq-answer rte';

      details.appendChild(summary);
      details.appendChild(currentContent);
      wrap.appendChild(details);
      currentItems.appendChild(wrap);

    } else if (currentContent) {
      currentContent.appendChild(node.cloneNode(true));
    }
  }

  if (hasStructure) {
    output.appendChild(fragment);
  } else {
    output.innerHTML = sourceEl.innerHTML;
  }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', buildFaq, { once: true });
  } else {
    buildFaq();
  }

  // Re-render in the theme editor when settings change
  document.addEventListener('shopify:section:load', function (event) {
    if (event.detail && event.detail.sectionId === id) buildFaq();
  });
})();
</script>

{% stylesheet %}
  .faq-content {
    --faq-group-gap: 3.5rem;
  }

  .faq-group + .faq-group {
    padding-block-start: var(--faq-group-gap);
  }

  .faq-group__heading {
    font-family: var(--faq-heading-font, var(--font-heading--family));
    font-size: var(--faq-heading-size, var(--font-h3--size));
    font-weight: var(--faq-heading-weight, var(--font-h3--weight));
    line-height: var(--font-h3--line-height);
    text-transform: var(--faq-heading-case, none);
    margin-block-end: var(--faq-heading-gap, 20px);
  }

  .faq-content .accordion {
    width: 100%;
  }

  .faq-content .accordion--dividers accordion-custom .details {
    border-color: var(--color-border);
    padding-bottom: 2px;
  }

  .faq-content .accordion--dividers accordion-custom:not(:first-child) .details {
    border-block-start: 1px solid var(--color-border);
  }

  .faq-content .accordion--dividers accordion-custom:first-child .details {
    border-block-start: 1px solid var(--color-border);
  }

  .faq-content .accordion--dividers accordion-custom:last-child .details {
    border-block-end: 1px solid var(--color-border);
  }

  .faq-content .accordion--dividers .faq-answer {
    padding-block-end: 0.75rem;
    overflow: visible;
    font-size: var(--faq-answer-size, inherit);
  }

  /* Plus/minus icon toggle */
  .faq-content .accordion--plus .icon-caret {
    display: none;
  }

  .faq-content .accordion--plus .icon-minus {
    display: none;
  }

  .faq-content .accordion--plus accordion-custom details[open] .icon-plus {
    display: none;
  }

  .faq-content .accordion--plus accordion-custom details[open] .icon-minus {
    display: block;
  }

  .faq-content .accordion .details__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--faq-question-font, var(--font-h6--family));
    font-style: var(--font-h6--style);
    font-weight: var(--faq-question-weight, var(--font-h6--weight));
    font-size: var(--faq-question-size, var(--font-h6--size));
    line-height: var(--font-h6--line-height);
    text-transform: var(--faq-question-case, var(--font-h6--case));
    min-height: var(--minimum-touch-target, 44px);
    cursor: pointer;
    list-style: none;
    width: 100%;
  }

  .faq-content .accordion .details__header::-webkit-details-marker {
    display: none;
  }

  .faq-content .svg-wrapper {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  @media screen and (max-width: 749px) {
    .faq-content .faq-group__heading {
      font-size: var(--faq-heading-size-mobile, var(--faq-heading-size, var(--font-h3--size)));
    }

    .faq-content .accordion .details__header {
      font-size: var(--faq-question-size-mobile, var(--faq-question-size, var(--font-h6--size)));
    }

    .faq-content .accordion--dividers .faq-answer {
      font-size: var(--faq-answer-size-mobile, var(--faq-answer-size, inherit));
    }
  }

{% endstylesheet %}

{% schema %}
{
  "name": "FAQ Content",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Category heading"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Font family",
      "options": [
        { "value": "heading", "label": "Heading" },
        { "value": "body", "label": "Body" },
        { "value": "subheading", "label": "Subheading" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "heading"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Font size (desktop)",
      "min": 16,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Font size (mobile)",
      "min": 14,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "range",
      "id": "heading_weight",
      "label": "Font weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "default": 400
    },
    {
      "type": "select",
      "id": "heading_case",
      "label": "Text case",
      "options": [
        { "value": "none", "label": "Default" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "lowercase", "label": "Lowercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "heading_margin",
      "label": "Space below heading",
      "min": 0,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 20
