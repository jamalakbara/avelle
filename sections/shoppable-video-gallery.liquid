      "default": "See more"
    },
    {
      "type": "text",
      "id": "load_more_label",
      "label": "Load-more button label (grid)",
      "default": "See More"
    },
    {
      "type": "header",
      "content": "Discover all card"
    },
    {
      "type": "text",
      "id": "see_more_text",
      "label": "Discover all label",
      "default": "See more"
    },
    {
      "type": "url",
      "id": "see_more_url",
      "label": "Discover all link",
      "info": "Shows a final card at the end of the carousel linking to your Avellebabes / community page. Hidden when blank."
    },
    {
      "type": "image_picker",
      "id": "see_more_image",
      "label": "Discover all image",
