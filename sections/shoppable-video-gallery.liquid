      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "ugc_video_item",
      "name": "UGC Video Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "thumbnail_image",
          "label": "Thumbnail image",
          "info": "Portrait (3:4 ratio recommended). Falls back to video preview image if left blank."
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Creator handle",
          "placeholder": "@username"
        },
        {
          "type": "url",
          "id": "handle_url",
          "label": "Handle link",
          "info": "Link the handle to the creator's profile (opens in a new tab)."
        },
        {
          "type": "product_list",
          "id": "product_list",
          "label": "Tagged products",
          "limit": 6
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shoppable Video Gallery",
      "blocks": [
        { "type": "ugc_video_item" },
        { "type": "ugc_video_item" },
        { "type": "ugc_video_item" },
        { "type": "ugc_video_item" }
      ]
    }
  ]
}
