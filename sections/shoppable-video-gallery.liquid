    {
      "type": "header",
      "content": "Popup typography"
    },
    {
      "type": "select",
      "id": "modal_heading_preset",
      "label": "Popup heading preset",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "default",
      "info": "Style for the 'Shop the look' heading. Edit preset styles in Theme settings → Typography."
    },
    {
      "type": "header",
      "content": "Creator handle"
    },
    {
      "type": "checkbox",
      "id": "show_handle",
      "label": "Show creator handle on cards",
      "default": true
    },
    {
      "type": "text",
      "id": "handle_prefix",
      "label": "Handle prefix",
      "info": "Shown before each handle, e.g. 'Styled by ' (include trailing space) or '@'. Leave blank for none."
    },
    {
      "type": "header",
      "content": "Cart behavior"
    },
    {
      "type": "checkbox",
      "id": "open_cart_after_add",
