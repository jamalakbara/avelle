    {
      "type": "select",
      "id": "body_font",
      "label": "Description font",
      "info": "Uses theme typography presets",
      "options": [
        { "value": "body", "label": "Body" },
        { "value": "subheading", "label": "Subheading" },
        { "value": "heading", "label": "Heading" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "body"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description size (desktop)",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "description_size_mobile",
      "label": "Description size (mobile)",
      "info": "0 = use desktop size",
      "min": 0,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "description_line_height",
      "label": "Description line height",
      "min": 1,
      "max": 2.5,
      "step": 0.1,
      "default": 1.8
    },
    {
      "type": "range",
      "id": "button_font_size_desktop",
      "label": "Button font size (desktop)",
      "min": 7,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 9
    },
    {
      "type": "range",
      "id": "button_font_size_mobile",
      "label": "Button font size (mobile)",
      "info": "0 = use desktop size",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "link_font_size_desktop",
