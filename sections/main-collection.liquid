<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% javascript %}
  const url = new URL(window.location.href);
  if (url.hash) {
    document.addEventListener(
      'DOMContentLoaded',
      () => {
        const card = document.getElementById(url.hash.slice(1));
        if (card) {
          card.scrollIntoView({ behavior: 'instant' });
        }
      },
      { once: true }
    );
  }
{% endjavascript %}

{% comment %} We always render this full-width, as the child blocks have width: page/full settings {% endcomment %}
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<results-list
  class="section product-grid-container color-{{ section.settings.color_scheme }}"
  style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
  section-id="{{ section.id }}"
  infinite-scroll="{{ section.settings.enable_infinite_scroll }}"
>
  {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

  {%- comment -%} Collection Hero Banner {%- endcomment -%}
  {% render 'collection-hero',
    collection: collection,
    products_count: collection.products_count,
    settings: section.settings
  %}

  {%- comment -%} Collection Card Styles {%- endcomment -%}
  {% render 'collection-card-styles.css' %}

  <div
    class="collection-wrapper collection-wrapper--tight-grid grid gap-style{% if section.settings.product_grid_width == 'full-width' %} collection-wrapper--grid-full-width{% endif %}"
  >
    {% content_for 'block',
      type: 'filters',
      id: 'filters',
      results: collection,
      results_size: collection.products_count
    %}

    {% assign products_per_page = 24 %}

    {% if section.settings.enable_infinite_scroll == false %}
      {% assign products_per_page = section.settings.products_per_page %}
    {% endif %}

    {% paginate collection.products by products_per_page %}
      {% capture children %}
        {% for product in collection.products %}
          <li
            id="{{ section.id }}-{{ product.id }}"
            class="product-grid__item product-grid__item--{{ forloop.index0 }}"
            data-page="{{ paginate.current_page }}"
            data-product-id="{{ product.id }}"
            ref="cards[]"
          >
            {% # theme-check-disable %}
            {% content_for 'block', type: '_product-card', id: 'product-card', closest.product: product %}
            {% # theme-check-enable %}
          </li>
        {% endfor %}
      {% endcapture %}

      {% render 'product-grid',
        section: section,
        children: children,
        products: collection.products,
        paginate: paginate,
        enable_infinite_scroll: section.settings.enable_infinite_scroll
      %}
    {% endpaginate %}
  </div>
</results-list>

{% stylesheet %}
  .main-collection-grid {
    grid-column: var(--grid-column--mobile);

    @media screen and (min-width: 750px) {
      grid-column: var(--grid-column--desktop);
    }
  }

  /* Typography matching curated-products-cinematic */
  .main-collection-grid .product-card .product-card__content a .text-block,
  .main-collection-grid .card__heading,
  .main-collection-grid .product-title,
  .main-collection-grid h3,
  .main-collection-grid .card__heading p,
  .main-collection-grid .text-block p {
    font-family: var(--font-heading--family) !important;
    font-size: var(--font-size--product_info) !important;
    text-transform: uppercase !important;
    letter-spacing: 0.05em !important;
    margin-bottom: 0.25rem;
    font-weight: 500 !important;
  }

  /* Price must match carousel .curated-card__price: BODY font, plain weight,
     no letter-spacing. The block uses type_preset h5 → inherits the heading
     font; override family + spacing here. */
  .main-collection-grid .product-card .product-card__content product-price,
  .main-collection-grid .product-card .product-card__content product-price .price,
  .main-collection-grid .price,
  .main-collection-grid .product-price {
    font-family: var(--font-body--family) !important;
    font-size: var(--font-size--product_info) !important;
    font-weight: 400 !important;
    letter-spacing: normal !important;
    opacity: 0.7;
    text-transform: none !important;
  }

  /* Match carousel image aspect ratio (2:3) for 1:1 card parity.
     Gallery is the positioning context for the pill + hover overlay. */
  .main-collection-grid .card-gallery {
    position: relative;
    --gallery-aspect-ratio: 2 / 3 !important;
  }

  /* Center ONLY the text groups (title/price/swatches) — do NOT touch
     .product-card__content itself or the gallery collapses to zero width. */
  .main-collection-grid .group-block-content {
    align-items: center !important;
    text-align: center !important;
  }

  /* Price block ships with .text-left → text-align AND --text-align:left.
     The money span reads var(--text-align), so override BOTH. */
  .main-collection-grid .product-card__content .product-title,
  .main-collection-grid .product-card__content .price,
  .main-collection-grid .product-card__content product-price,
  .main-collection-grid .product-card__content product-price [ref='priceContainer'] {
    --text-align: center !important;
    text-align: center !important;
    justify-content: center !important;
  }

  /* Tighten info to match carousel .curated-card__info (8px under image, snug rows).
     Kill the nested-group paddings (incl. the asymmetric 12px left that shifts
     content off-centre) and collapse gaps. */
  .main-collection-grid .product-card__content {
    gap: 8px !important;
  }

  .main-collection-grid .product-card__content .group-block {
    padding: 0 !important;
  }

  .main-collection-grid .product-card__content .group-block-content {
    gap: 4px !important;
    row-gap: 4px !important;
  }

  .main-collection-grid .product-card__content .product-title {
    margin-bottom: 0 !important;
  }

  /* Cinematic add-to-cart pill — mirrors sections/carousel-cinematic.liquid,
     consuming the SAME global --cbtn-* tokens (single source of truth = DRY). */
  .main-collection-grid .quick-add {
    inset: auto var(--padding-sm) var(--padding-sm) var(--padding-sm);
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .main-collection-grid .product-card:hover .quick-add,
  .main-collection-grid .product-card:focus-within .quick-add {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.1s;
  }

  /* Image darken on hover, like the carousel overlay */
  .main-collection-grid .card-gallery::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.25);
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
    z-index: 1;
  }

  .main-collection-grid .product-card:hover .card-gallery::after {
    opacity: 1;
  }

  .main-collection-grid .quick-add__product-form-component,
  .main-collection-grid .quick-add__product-form-component .shopify-product-form {
    width: 100%;
    display: block;
  }

  /* Always direct-add → the choose-options button is never used. Hide it so
     our display:inline-flex override below doesn't reveal a second pill. */
  .main-collection-grid .quick-add__button.quick-add__button--choose {
    display: none !important;
  }

  /* Restyle Dawn's circular quick-add button into the cinematic outline pill. */
  .main-collection-grid .quick-add__button {
    position: static;
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: auto;
    opacity: 1 !important;
    border-radius: var(--cbtn-border-radius, 999px);
    border: var(--cbtn-border-width, 1px) solid var(--cbtn-color, #fff);
    background: transparent;
    color: var(--cbtn-color, #fff);
    backdrop-filter: none;
    overflow: visible;
    font-size: var(--cbtn-font-size, 0.5625rem);
    font-weight: var(--cbtn-font-weight, 500);
    letter-spacing: var(--cbtn-letter-spacing, 0.15em);
    text-transform: uppercase;
    white-space: nowrap;
    padding-block: var(--cbtn-padding-block, 0.75rem);
    padding-inline: var(--cbtn-padding-inline, 2rem);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .main-collection-grid .quick-add__button:hover {
    scale: 1;
    background: var(--cbtn-hover-bg, var(--cbtn-color, #fff));
    color: var(--cbtn-hover-text, #000);
    transform: translateY(-2px);
  }

  /* Strip Dawn's inner pill background + icon so only the label shows */
  .main-collection-grid .quick-add__button .add-to-cart-text {
    background: transparent;
    border-radius: 0;
    height: auto;
    color: inherit;
  }

  .main-collection-grid .quick-add__button .add-to-cart-icon {
    display: none;
  }

  .main-collection-grid .quick-add__button .add-to-cart-text__content {
    grid-template-columns: 1fr;
    font-size: inherit;
    font-weight: inherit;
    letter-spacing: inherit;
  }

  .main-collection-grid .quick-add__button .add-to-cart-text__content span span {
    opacity: 1;
    translate: 0 0;
    filter: blur(0);
    padding-right: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.collection_container",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "organic",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "t:settings.card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "extra-large",
          "label": "t:options.extra_large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "t:settings.mobile_card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "small"
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Columns (mobile)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "t:settings.auto_load_products",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:settings.products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 24,
      "visible_if": "{{ section.settings.enable_infinite_scroll == false }}"
    },
    {
      "type": "header",
      "content": "Collection Hero"
    },
    {
      "type": "paragraph",
      "content": "Settings for the hero banner."
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "label": "Show collection description",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_collection_count",
      "label": "Show items count",
      "default": false
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "small"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "centered",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "centered"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "t:settings.full_width_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.product_grid_width != 'full-width' }}"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": []
}
{% endschema %}
