

{% liquid
  assign block_settings = block.settings
  assign menu = block_settings.menu
  assign heading = block_settings.heading
  assign color_scheme = block_settings.color_scheme
  assign show_as_accordion = block_settings.show_as_accordion
  if show_as_accordion == true and block_settings.accordion_dividers == true
    assign dividers_enabled = true
  endif
%}

{% if menu != blank or heading != blank %}
  <accordion-custom
    class="
      menu
      menu--{{ block.id }}
      {% if show_as_accordion == true %} menu--accordion menu--{{ block_settings.accordion_icon }}{% endif %}
      {% if dividers_enabled == true %} menu--dividers{% endif %}
    "
    data-disable-on-desktop="true"
    open-by-default-on-desktop
    {% if show_as_accordion == false %}
      data-disable-on-mobile="true"
      open-by-default-on-mobile
    {% endif %}
  >
    <details
      class="
        menu__details
        spacing-style
        {% if block_settings.inherit_color_scheme == false %} color-{{ color_scheme }}{% endif %}
      "
      data-testid="menu-details"
      style="
        --spacing--size: {{ block_settings.menu_spacing }}px;
        {% render 'spacing-style', settings: block_settings %}
      "
      {% if show_as_accordion == false %}
        open
      {% endif %}
      {{ block.shopify_attributes }}
    >
      <summary class="menu__heading{% if heading == blank %} menu__heading--empty{% endif %} {{ block_settings.heading_preset }}{% if block_settings.heading_bold %} menu__heading--bold{% endif %}{% if block_settings.heading_uppercase %} menu__heading--uppercase{% endif %}">
        <span class="menu__heading__default">{{ heading }}</span>
        <span class="menu__heading__accordion">
          {{ heading | default: menu.title }}
          <span class="menu__heading__toggle svg-wrapper icon-caret icon-animated">
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </span>
          <span class="menu__heading__toggle svg-wrapper icon-plus">
            {{- 'icon-plus.svg' | inline_asset_content -}}
          </span>
        </span>
      </summary>

      <div class="details-content">
        {% if menu %}
          <ul class="list-unstyled">
            {% for link in menu.links %}
              <li class="menu__item {{ block_settings.link_preset }}">
                <a href="{{ link.url }}">
                  {{ link.title }}
                </a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </details>
  </accordion-custom>

  {%- liquid
    assign heading_font_family = block_settings.heading_font_family | default: 'default'
    assign heading_size_desktop = block_settings.heading_size_desktop | default: 0
    assign heading_size_mobile = block_settings.heading_size_mobile | default: 0
    assign link_font_family = block_settings.link_font_family | default: 'default'
    assign link_size_desktop = block_settings.link_size_desktop | default: 0
    assign link_size_mobile = block_settings.link_size_mobile | default: 0
  -%}
  {%- if heading_font_family != 'default' or heading_size_desktop > 0 or heading_size_mobile > 0 or link_font_family != 'default' or link_size_desktop > 0 or link_size_mobile > 0 -%}
    {% style %}
      {%- if heading_font_family != 'default' or heading_size_desktop > 0 %}
      .menu--{{ block.id }} .menu__heading {
        {%- if heading_font_family != 'default' %}font-family: var(--font-{{ heading_font_family }}--family);{% endif -%}
        {%- if heading_size_desktop > 0 %}font-size: {{ heading_size_desktop }}px;{% endif -%}
      }
      {% endif -%}
      {%- if link_font_family != 'default' or link_size_desktop > 0 %}
      .menu--{{ block.id }} .menu__item {
        {%- if link_font_family != 'default' %}font-family: var(--font-{{ link_font_family }}--family);{% endif -%}
        {%- if link_size_desktop > 0 %}font-size: {{ link_size_desktop }}px;{% endif -%}
      }
      {% endif -%}
      {%- if heading_size_mobile > 0 or link_size_mobile > 0 %}
      @media screen and (max-width: 749px) {
        {%- if heading_size_mobile > 0 %}
        .menu--{{ block.id }} .menu__heading { font-size: {{ heading_size_mobile }}px; }
        {% endif -%}
        {%- if link_size_mobile > 0 %}
        .menu--{{ block.id }} .menu__item { font-size: {{ link_size_mobile }}px; }
        {% endif -%}
      }
      {% endif -%}
    {% endstyle %}
  {%- endif -%}
{% endif %}

{% stylesheet %}
  .menu {
    width: 100%;
  }

  .menu:not(:has(.menu__heading--empty)) .details-content {
    margin-block-start: var(--spacing--size);
  }

  .menu__item + .menu__item {
    margin-block-start: var(--spacing--size);
  }

  .menu .menu__heading--empty {
    display: none;
  }

  .menu .menu__details .menu__heading--bold,
  .menu .menu__details .menu__heading--bold .menu__heading__default,
  .menu .menu__details .menu__heading--bold .menu__heading__accordion {
    font-weight: 700;
  }

  .menu .menu__details .menu__heading--uppercase {
    text-transform: uppercase;
  }

  .menu__heading__default {
    display: contents;
  }

  .menu__heading__accordion {
    display: none;
  }

  @media screen and (max-width: 749px) {
    /* Always show the fallback heading on mobile when accordion is enabled */
    .menu--accordion .menu__heading--empty {
      display: flex;
    }

    .menu--accordion .menu__heading__accordion {
      display: contents;
    }

    .menu--accordion .menu__heading__default {
      display: none;
    }

    .menu--accordion .details-content {
      margin-block-start: var(--spacing--size);
    }

    .menu--accordion .menu__details {
      padding-inline: 0;
    }

    .menu--dividers .menu__details {
      border-block-end: var(--style-border-width) solid var(--color-border);
    }

    .menu--dividers .details-content {
      padding-block-end: var(--padding-sm);
    }
  }

  .menu--caret .icon-plus,
  .menu--plus .icon-caret {
    display: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.menu",
  "tag": null,
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:settings.menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "range",
      "id": "menu_spacing",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_as_accordion",
      "label": "t:settings.show_as_accordion",
      "default": false
    },
    {
      "type": "select",
      "id": "accordion_icon",
      "label": "t:settings.icon",
      "options": [
        {
          "value": "caret",
          "label": "t:options.caret"
        },
        {
          "value": "plus",
          "label": "t:options.plus"
        }
      ],
      "default": "caret",
      "visible_if": "{{ block.settings.show_as_accordion == true }}"
    },
    {
      "type": "checkbox",
      "id": "accordion_dividers",
      "label": "t:settings.dividers",
      "default": false,
      "visible_if": "{{ block.settings.show_as_accordion == true }}"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "header",
      "content": "t:content.typography"
    },
    {
      "type": "select",
      "id": "heading_preset",
      "label": "t:settings.heading_preset",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "paragraph",
          "label": "t:options.paragraph"
        },
        {
          "value": "h1",
          "label": "t:options.h1"
        },
        {
          "value": "h2",
          "label": "t:options.h2"
        },
        {
          "value": "h3",
          "label": "t:options.h3"
        },
        {
          "value": "h4",
          "label": "t:options.h4"
        },
        {
          "value": "h5",
          "label": "t:options.h5"
        },
        {
          "value": "h6",
          "label": "t:options.h6"
        }
      ],
      "default": "h3"
    },
    {
      "type": "checkbox",
      "id": "heading_bold",
      "label": "t:options.bold",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "t:options.uppercase",
      "default": false
    },
    {
      "type": "select",
      "id": "link_preset",
      "label": "t:settings.link_preset",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "paragraph",
          "label": "t:options.paragraph"
        },
        {
          "value": "h1",
          "label": "t:options.h1"
        },
        {
          "value": "h2",
          "label": "t:options.h2"
        },
        {
          "value": "h3",
          "label": "t:options.h3"
        },
        {
          "value": "h4",
          "label": "t:options.h4"
        },
        {
          "value": "h5",
          "label": "t:options.h5"
        },
        {
          "value": "h6",
          "label": "t:options.h6"
        }
      ],
      "default": "paragraph"
    },
    {
      "type": "select",
      "id": "heading_font_family",
      "label": "Heading font family",
      "options": [
        { "value": "default", "label": "Theme default" },
        { "value": "body", "label": "Body" },
        { "value": "heading", "label": "Heading" },
        { "value": "subheading", "label": "Subheading" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size (desktop)",
      "info": "0 = use preset",
      "min": 0,
      "max": 60,
      "step": 1,
