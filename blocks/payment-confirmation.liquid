{% capture submit_button %}
  {% content_for 'block', type: 'contact-form-submit-button', id: 'submit-button' %}
{% endcapture %}

<div
  class="
    payment-confirmation
    spacing-style size-style
    {% if block.settings.inherit_color_scheme == false %}color-{{ block.settings.color_scheme }}{% endif %}
  "
  style="
    {% render 'spacing-style', settings: block.settings %}
    {% render 'size-style', settings: block.settings %}
  "
  {{ block.shopify_attributes }}
>
  {%- if block.settings.show_bank_details -%}
    <div class="payment-confirmation__bank">
      {%- if block.settings.bank_heading != blank -%}
        <p class="payment-confirmation__bank-heading">{{ block.settings.bank_heading }}</p>
      {%- endif -%}

      <dl class="payment-confirmation__bank-rows">
        {%- if block.settings.bank_name != blank -%}
          <div class="payment-confirmation__bank-row">
            <dt>{{ block.settings.bank_name_label }}</dt>
            <dd>{{ block.settings.bank_name }}</dd>
          </div>
        {%- endif -%}
        {%- if block.settings.account_number != blank -%}
          <div class="payment-confirmation__bank-row">
            <dt>{{ block.settings.account_number_label }}</dt>
            <dd>
              <span data-copy-value="{{ block.settings.account_number }}">{{ block.settings.account_number }}</span>
              <button type="button" class="payment-confirmation__copy" data-copy-account aria-label="Copy account number">Copy</button>
            </dd>
          </div>
        {%- endif -%}
        {%- if block.settings.account_holder != blank -%}
          <div class="payment-confirmation__bank-row">
            <dt>{{ block.settings.account_holder_label }}</dt>
            <dd>{{ block.settings.account_holder }}</dd>
          </div>
        {%- endif -%}
      </dl>

      {%- if block.settings.bank_instructions != blank -%}
        <div class="payment-confirmation__bank-note">{{ block.settings.bank_instructions }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {% assign form_id = block.id | default: section.id | prepend: 'PaymentConfirmation-' %}
  <form
    action="https://api.web3forms.com/submit"
    method="POST"
    enctype="multipart/form-data"
    class="payment-confirmation__form"
    id="{{ form_id }}"
    data-payment-form
  >
    <input type="hidden" name="access_key" value="{{ block.settings.web3forms_key }}">
    <input type="hidden" name="subject" value="{{ block.settings.email_subject }}">
    <input type="hidden" name="from_name" value="{{ shop.name }} — Payment Confirmation">
    <input type="hidden" name="Submission Type" value="Payment Proof">
    {%- comment -%} Honeypot: bots fill this, humans can't see it {%- endcomment -%}
    <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" style="display: none !important;" aria-hidden="true">

    <div class="payment-confirmation__error" data-form-error tabindex="-1" hidden></div>

    <div class="payment-confirmation__fields" data-form-fields>
      <div class="payment-confirmation__form-row">
        <label class="visually-hidden" for="{{ form_id }}-order">Order number</label>
        <input
          type="text"
          id="{{ form_id }}-order"
          class="payment-confirmation__input"
          name="Order Number"
          data-order-field
          placeholder="Order number (e.g. #1042)"
        >

        <label class="visually-hidden" for="{{ form_id }}-email">Email</label>
        <input
          type="email"
          id="{{ form_id }}-email"
          class="payment-confirmation__input"
          autocomplete="email"
          name="email"
          spellcheck="false"
          autocapitalize="off"
          required
          value="{% if customer %}{{ customer.email }}{% endif %}"
          placeholder="Email *"
        >
      </div>

      <div class="payment-confirmation__form-row">
        <label class="visually-hidden" for="{{ form_id }}-sender">Sender name</label>
        <input
          type="text"
          id="{{ form_id }}-sender"
          class="payment-confirmation__input"
          autocomplete="name"
          name="Sender Name"
          value="{% if customer %}{{ customer.name }}{% endif %}"
          placeholder="Name on bank account"
        >

        <label class="visually-hidden" for="{{ form_id }}-amount">Amount transferred</label>
        <input
          type="text"
          id="{{ form_id }}-amount"
          class="payment-confirmation__input"
          name="Amount"
          placeholder="Amount transferred"
        >
      </div>

      <label class="visually-hidden" for="{{ form_id }}-bank">Bank sent from</label>
      <input
        type="text"
        id="{{ form_id }}-bank"
        class="payment-confirmation__input"
        name="Bank Sent From"
        placeholder="Bank you transferred from"
      >

      {%- if block.settings.enable_file_upload -%}
        <div class="payment-confirmation__upload">
          <label class="payment-confirmation__upload-label" for="{{ form_id }}-file">
            {{ block.settings.upload_label }}
          </label>
          <input
            type="file"
            id="{{ form_id }}-file"
            class="payment-confirmation__file"
            name="Receipt"
            accept="image/*,application/pdf"
          >
        </div>
      {%- endif -%}

      {%- if block.settings.enable_link_fallback -%}
        <label class="visually-hidden" for="{{ form_id }}-link">Proof link</label>
        <input
          type="url"
          id="{{ form_id }}-link"
          class="payment-confirmation__input"
          name="Proof Link"
          placeholder="{{ block.settings.link_placeholder }}"
        >
      {%- endif -%}

      <label class="visually-hidden" for="{{ form_id }}-body">Note</label>
      <textarea
        rows="4"
        id="{{ form_id }}-body"
        class="payment-confirmation__input payment-confirmation__input--textarea"
        name="Note"
        placeholder="Note (optional)"
      ></textarea>

      {{ submit_button }}
    </div>

    <div class="payment-confirmation__success" data-form-success tabindex="-1" hidden>
      {{- 'icon-checkmark.svg' | inline_asset_content -}}
      {{ block.settings.success_message }}
    </div>
  </form>
</div>

<script type="module">
  (function () {
    var params = new URLSearchParams(window.location.search);
    var order = params.get('order');
    if (!order) return;
    document.querySelectorAll('[data-order-field]').forEach(function (el) {
      if (!el.value) el.value = order;
    });
  })();

  document.querySelectorAll('[data-copy-account]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var target = btn.parentElement.querySelector('[data-copy-value]');
      if (!target || !navigator.clipboard) return;
      navigator.clipboard.writeText(target.getAttribute('data-copy-value')).then(function () {
        var prev = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(function () { btn.textContent = prev; }, 1500);
      });
    });
  });

  document.querySelectorAll('[data-payment-form]').forEach(function (form) {
    var fields = form.querySelector('[data-form-fields]');
    var success = form.querySelector('[data-form-success]');
    var error = form.querySelector('[data-form-error]');
    var submit = form.querySelector('button[type="submit"]');

    form.addEventListener('submit', function (event) {
      event.preventDefault();
      error.hidden = true;
      error.textContent = '';
      if (submit) submit.disabled = true;

      fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' }
      })
        .then(function (response) {
          return response.json().then(function (data) {
            return { ok: response.ok, data: data };
          });
        })
        .then(function (result) {
          if (result.ok && result.data.success) {
            fields.hidden = true;
            success.hidden = false;
            success.focus();
          } else {
            throw new Error((result.data && result.data.message) || 'Submission failed. Please try again.');
          }
        })
        .catch(function (err) {
          error.textContent = err.message || 'Something went wrong. Please try again.';
          error.hidden = false;
          error.focus();
          if (submit) submit.disabled = false;
        });
    });
  });
</script>

{% stylesheet %}
  .payment-confirmation__form {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xl, 2rem);
  }

  .payment-confirmation__form-row {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xl, 2rem);

    @media screen and (min-width: 750px) {
      flex-direction: row;
      align-items: flex-start;
    }
  }

  .payment-confirmation__form-row > * {
    flex: 1;
  }

  .payment-confirmation__input {
    width: 100%;
    color: var(--color-input-text);
    background-color: transparent;
    padding-block: var(--padding-lg);
    padding-inline: 0;
    border-radius: 0;
    border: none;
    border-bottom: 1px solid var(--color-input-border);
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    -webkit-font-smoothing: antialiased;
    transition: border-color 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .payment-confirmation__input:focus {
    outline: none;
    border-bottom-color: var(--color-foreground);
  }

  .payment-confirmation__input::placeholder {
    color: var(--color-input-text);
    opacity: 0.45;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    text-transform: uppercase;
  }

  .payment-confirmation__input--textarea {
    resize: none;
    min-height: 120px;
    border: 1px solid var(--color-input-border);
    padding: var(--padding-lg) var(--padding-xl);
  }

  .payment-confirmation__input--textarea:focus {
    border-color: var(--color-foreground);
  }

  .payment-confirmation__bank {
    margin-block-end: var(--gap-xl, 2rem);
    padding: var(--padding-xl, 2rem);
    border: 1px solid var(--color-input-border);
  }

  .payment-confirmation__bank-heading {
    margin: 0 0 var(--gap-lg, 1.5rem);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.75rem;
    opacity: 0.7;
  }

  .payment-confirmation__bank-rows {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--gap-md, 1rem);
  }

  .payment-confirmation__bank-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--gap-md, 1rem);
    border-bottom: 1px solid var(--color-input-border);
    padding-block-end: var(--gap-md, 1rem);
  }

  .payment-confirmation__bank-row:last-child {
    border-bottom: none;
    padding-block-end: 0;
  }

  .payment-confirmation__bank-row dt {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.7rem;
    opacity: 0.6;
  }

  .payment-confirmation__bank-row dd {
    margin: 0;
    font-size: 1rem;
    display: flex;
    align-items: center;
    gap: var(--gap-sm, 0.5rem);
  }

  .payment-confirmation__copy {
    background: transparent;
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    color: inherit;
  }

  .payment-confirmation__bank-note {
    margin-block-start: var(--gap-lg, 1.5rem);
    font-size: 0.85rem;
    opacity: 0.8;
    line-height: 1.5;
  }

  .payment-confirmation__upload-label {
    display: block;
    margin-block-end: var(--gap-sm, 0.5rem);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    opacity: 0.7;
  }

  .payment-confirmation__file {
    width: 100%;
    font-size: 0.85rem;
  }

  .payment-confirmation__error,
  .payment-confirmation__success {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
  }

  .payment-confirmation [hidden] {
    display: none !important;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Payment confirmation",
  "tag": null,
  "settings": [
