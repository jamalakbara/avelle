      "id": "bank_heading",
      "label": "Bank details heading",
      "default": "Transfer to"
    },
    {
      "type": "text",
      "id": "bank_name_label",
      "label": "Bank name label",
      "default": "Bank"
    },
    {
      "type": "text",
      "id": "bank_name",
      "label": "Bank name",
      "default": "BCA"
    },
    {
      "type": "text",
      "id": "account_number_label",
      "label": "Account number label",
      "default": "Account number"
    },
    {
      "type": "text",
      "id": "account_number",
      "label": "Account number",
      "default": "1234567890"
    },
    {
      "type": "text",
      "id": "account_holder_label",
      "label": "Account holder label",
      "default": "Account holder"
    },
    {
      "type": "text",
      "id": "account_holder",
      "label": "Account holder",
      "default": "PT Avelle"
    },
    {
      "type": "richtext",
      "id": "bank_instructions",
      "label": "Instructions",
      "default": "<p>Transfer the exact order total, then submit your proof below. We verify within 1×24 hours.</p>"
    },
    {
      "type": "header",
      "content": "Proof upload"
    },
    {
      "type": "checkbox",
      "id": "enable_file_upload",
      "label": "Enable file upload",
      "info": "Native attachment. May be capped or disabled on some plans — test on your store.",
      "default": true
    },
    {
      "type": "text",
      "id": "upload_label",
      "label": "Upload label",
      "default": "Upload transfer receipt (image or PDF)"
    },
    {
      "type": "checkbox",
      "id": "enable_link_fallback",
      "label": "Enable proof link field",
      "info": "Fallback if upload fails — customer pastes a link to the receipt.",
      "default": true
    },
    {
      "type": "text",
      "id": "link_placeholder",
      "label": "Link field placeholder",
      "default": "Or paste a link to your receipt"
    },
    {
      "type": "header",
      "content": "Email delivery (Web3Forms)"
    },
    {
      "type": "text",
      "id": "web3forms_key",
      "label": "Web3Forms access key",
      "info": "From web3forms.com — determines which inbox receives submissions.",
      "default": "f6ba5bf5-669d-4962-a340-bd77f64d9627"
    },
    {
      "type": "text",
      "id": "email_subject",
      "label": "Email subject",
      "default": "New payment proof submission"
    },
    {
      "type": "header",
      "content": "Confirmation"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks — we received your payment proof and will verify your order shortly."
    },
    {
      "type": "header",
      "content": "t:settings.width_desktop"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width_desktop",
      "options": [
        { "value": "fit-content", "label": "t:options.fit_content" },
        { "value": "custom", "label": "t:options.custom" }
      ],
      "default": "custom"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 60,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        { "value": "fit-content", "label": "t:options.fit_content" },
        { "value": "custom", "label": "t:options.custom" }
      ],
      "default": "custom"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Payment confirmation",
      "category": "t:categories.forms"
    }
  ]
}
{% endschema %}
