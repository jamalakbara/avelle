<div
  class="
    payment-confirmation
    spacing-style size-style
    {% if block.settings.inherit_color_scheme == false %}color-{{ block.settings.color_scheme }}{% endif %}
  "
  style="
    {% render 'spacing-style', settings: block.settings %}
    {% render 'size-style', settings: block.settings %}
  "
  {{ block.shopify_attributes }}
>
  {%- if block.settings.show_bank_details -%}
    <div class="payment-confirmation__bank">
      {%- if block.settings.bank_heading != blank -%}
        <p class="payment-confirmation__bank-heading">{{ block.settings.bank_heading }}</p>
      {%- endif -%}

      <dl class="payment-confirmation__bank-rows">
        {%- if block.settings.bank_name != blank -%}
          <div class="payment-confirmation__bank-row">
            <dt>{{ block.settings.bank_name_label }}</dt>
            <dd>{{ block.settings.bank_name }}</dd>
          </div>
        {%- endif -%}
        {%- if block.settings.account_number != blank -%}
          <div class="payment-confirmation__bank-row">
            <dt>{{ block.settings.account_number_label }}</dt>
            <dd>
              <span data-copy-value="{{ block.settings.account_number }}">{{ block.settings.account_number }}</span>
              <button type="button" class="payment-confirmation__copy" data-copy-account aria-label="Copy account number">Copy</button>
            </dd>
          </div>
        {%- endif -%}
        {%- if block.settings.account_holder != blank -%}
          <div class="payment-confirmation__bank-row">
            <dt>{{ block.settings.account_holder_label }}</dt>
            <dd>{{ block.settings.account_holder }}</dd>
          </div>
        {%- endif -%}
      </dl>

      {%- if block.settings.bank_instructions != blank -%}
        <div class="payment-confirmation__bank-note">{{ block.settings.bank_instructions }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

<script type="module">
  document.querySelectorAll('[data-copy-account]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var target = btn.parentElement.querySelector('[data-copy-value]');
      if (!target || !navigator.clipboard) return;
      navigator.clipboard.writeText(target.getAttribute('data-copy-value')).then(function () {
        var prev = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(function () { btn.textContent = prev; }, 1500);
      });
    });
  });
</script>

{% stylesheet %}
  .payment-confirmation__bank {
    padding: var(--padding-xl, 2rem);
    border: 1px solid var(--color-input-border);
  }

  .payment-confirmation__bank-heading {
    margin: 0 0 var(--gap-lg, 1.5rem);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.75rem;
    opacity: 0.7;
  }

  .payment-confirmation__bank-rows {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--gap-md, 1rem);
  }

  .payment-confirmation__bank-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--gap-md, 1rem);
    border-bottom: 1px solid var(--color-input-border);
    padding-block-end: var(--gap-md, 1rem);
  }

  .payment-confirmation__bank-row:last-child {
    border-bottom: none;
    padding-block-end: 0;
  }

  .payment-confirmation__bank-row dt {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.7rem;
    opacity: 0.6;
  }

  .payment-confirmation__bank-row dd {
    margin: 0;
    font-size: 1rem;
    display: flex;
    align-items: center;
    gap: var(--gap-sm, 0.5rem);
  }

  .payment-confirmation__copy {
    background: transparent;
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    color: inherit;
  }

  .payment-confirmation__bank-note {
    margin-block-start: var(--gap-lg, 1.5rem);
    font-size: 0.85rem;
    opacity: 0.8;
    line-height: 1.5;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Payment bank details",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Bank details"
    },
    {
      "type": "checkbox",
      "id": "show_bank_details",
      "label": "Show bank details",
      "default": true
    },
    {
      "type": "text",
      "id": "bank_heading",
      "label": "Bank details heading",
      "default": "Transfer to"
    },
    {
      "type": "text",
      "id": "bank_name_label",
      "label": "Bank name label",
      "default": "Bank"
    },
    {
      "type": "text",
      "id": "bank_name",
      "label": "Bank name",
      "default": "BCA"
    },
    {
      "type": "text",
      "id": "account_number_label",
      "label": "Account number label",
      "default": "Account number"
    },
    {
      "type": "text",
      "id": "account_number",
      "label": "Account number",
      "default": "1234567890"
    },
    {
      "type": "text",
      "id": "account_holder_label",
      "label": "Account holder label",
      "default": "Account holder"
    },
    {
      "type": "text",
      "id": "account_holder",
      "label": "Account holder",
      "default": "PT Avelle"
    },
    {
      "type": "richtext",
      "id": "bank_instructions",
      "label": "Instructions",
      "default": "<p>Transfer the exact order total, then submit your proof below. We verify within 1×24 hours.</p>"
    },
    {
      "type": "header",
      "content": "t:settings.width_desktop"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width_desktop",
      "options": [
        { "value": "fit-content", "label": "t:options.fit_content" },
        { "value": "custom", "label": "t:options.custom" }
      ],
      "default": "custom"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 60,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        { "value": "fit-content", "label": "t:options.fit_content" },
        { "value": "custom", "label": "t:options.custom" }
      ],
      "default": "custom"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Payment bank details",
      "category": "t:categories.forms"
    }
  ]
}
{% endschema %}
