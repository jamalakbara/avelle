<div
  class="
    payment-confirmation
    spacing-style size-style
    {% if block.settings.inherit_color_scheme == false %}color-{{ block.settings.color_scheme }}{% endif %}
  "
  style="
    {% render 'spacing-style', settings: block.settings %}
    {% render 'size-style', settings: block.settings %}
  "
  {{ block.shopify_attributes }}
>
  {%- if block.settings.show_bank_details -%}
    <div class="payment-confirmation__bank">
      {%- if block.settings.bank_heading != blank -%}
        <p class="payment-confirmation__bank-heading">{{ block.settings.bank_heading }}</p>
      {%- endif -%}

      <dl class="payment-confirmation__bank-rows">
        {%- if block.settings.bank_name != blank -%}
          <div class="payment-confirmation__bank-row">
            <dt>{{ block.settings.bank_name_label }}</dt>
            <dd>{{ block.settings.bank_name }}</dd>
          </div>
        {%- endif -%}
        {%- if block.settings.account_number != blank -%}
          <div class="payment-confirmation__bank-row">
            <dt>{{ block.settings.account_number_label }}</dt>
            <dd>
              <span data-copy-value="{{ block.settings.account_number }}">{{ block.settings.account_number }}</span>
              <button type="button" class="payment-confirmation__copy" data-copy-account aria-label="Copy account number">Copy</button>
            </dd>
          </div>
        {%- endif -%}
        {%- if block.settings.account_holder != blank -%}
          <div class="payment-confirmation__bank-row">
            <dt>{{ block.settings.account_holder_label }}</dt>
            <dd>{{ block.settings.account_holder }}</dd>
          </div>
        {%- endif -%}
      </dl>

      {%- if block.settings.bank_instructions != blank -%}
        <div class="payment-confirmation__bank-note">{{ block.settings.bank_instructions }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if block.settings.show_form -%}
    <form
      class="payment-confirmation__form"
      data-wa-form
      data-wa-number="{{ block.settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' }}"
    >
      {%- if block.settings.form_heading != blank -%}
        <p class="payment-confirmation__form-heading">{{ block.settings.form_heading }}</p>
      {%- endif -%}

      <div class="payment-confirmation__field">
        <label for="pc-order">{{ block.settings.label_order }}</label>
        <input type="text" id="pc-order" name="order" class="payment-confirmation__input" required placeholder="{{ block.settings.label_order | escape }}">
      </div>

      <div class="payment-confirmation__field">
        <label for="pc-name">{{ block.settings.label_name }}</label>
        <input type="text" id="pc-name" name="name" class="payment-confirmation__input" required placeholder="{{ block.settings.label_name | escape }}">
      </div>

      <div class="payment-confirmation__field">
        <label for="pc-amount">{{ block.settings.label_amount }}</label>
        <input type="text" id="pc-amount" name="amount" class="payment-confirmation__input" required inputmode="numeric" placeholder="{{ block.settings.label_amount | escape }}">
      </div>

      <div class="payment-confirmation__field">
        <label for="pc-bank">{{ block.settings.label_bank }}</label>
        <input type="text" id="pc-bank" name="bank" class="payment-confirmation__input" required placeholder="{{ block.settings.label_bank | escape }}">
      </div>

      <div class="payment-confirmation__field">
        <label for="pc-note">{{ block.settings.label_note }}</label>
        <textarea id="pc-note" name="note" rows="3" class="payment-confirmation__input payment-confirmation__input--textarea" placeholder="{{ block.settings.label_note | escape }}"></textarea>
      </div>

      {%- if block.settings.receipt_note != blank -%}
        <p class="payment-confirmation__receipt-note">{{ block.settings.receipt_note }}</p>
      {%- endif -%}

      <button type="submit" class="payment-confirmation__submit button">{{ block.settings.submit_label }}</button>
    </form>
  {%- endif -%}
</div>

<script type="module">
  document.querySelectorAll('[data-copy-account]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var target = btn.parentElement.querySelector('[data-copy-value]');
      if (!target || !navigator.clipboard) return;
      navigator.clipboard.writeText(target.getAttribute('data-copy-value')).then(function () {
        var prev = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(function () { btn.textContent = prev; }, 1500);
      });
    });
  });

  document.querySelectorAll('[data-wa-form]').forEach(function (form) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var number = form.getAttribute('data-wa-number') || '';
      if (!number) {
        alert('WhatsApp number not set. Please contact the store.');
        return;
      }
      var get = function (n) {
        var el = form.querySelector('[name="' + n + '"]');
        return el ? el.value.trim() : '';
      };
      var lines = [
        'Payment Confirmation',
        '',
        'Order number: ' + get('order'),
        'Sender name: ' + get('name'),
        'Amount: ' + get('amount'),
        'Bank sent from: ' + get('bank')
      ];
      var note = get('note');
      if (note) lines.push('Note: ' + note);
      lines.push('');
      lines.push('(I will attach my transfer receipt below)');
      var url = 'https://wa.me/' + number + '?text=' + encodeURIComponent(lines.join('\n'));
      window.open(url, '_blank');
    });
  });
</script>

{% stylesheet %}
  .payment-confirmation__bank {
    padding: var(--padding-xl, 2rem);
    border: 1px solid var(--color-input-border);
  }

  .payment-confirmation__bank-heading {
    margin: 0 0 var(--gap-lg, 1.5rem);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.75rem;
    opacity: 0.7;
  }

  .payment-confirmation__bank-rows {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--gap-md, 1rem);
  }

  .payment-confirmation__bank-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--gap-md, 1rem);
    border-bottom: 1px solid var(--color-input-border);
    padding-block-end: var(--gap-md, 1rem);
  }

  .payment-confirmation__bank-row:last-child {
    border-bottom: none;
    padding-block-end: 0;
  }

  .payment-confirmation__bank-row dt {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.7rem;
    opacity: 0.6;
  }

  .payment-confirmation__bank-row dd {
    margin: 0;
    font-size: 1rem;
    display: flex;
    align-items: center;
    gap: var(--gap-sm, 0.5rem);
  }

  .payment-confirmation__copy {
    background: transparent;
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    color: inherit;
  }

  .payment-confirmation__bank-note {
    margin-block-start: var(--gap-lg, 1.5rem);
    font-size: 0.85rem;
    opacity: 0.8;
    line-height: 1.5;
  }

  .payment-confirmation__form {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg, 1.5rem);
    margin-block-start: var(--gap-xl, 2rem);
    text-align: left;
  }

  .payment-confirmation__form-heading {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.75rem;
    opacity: 0.7;
  }

  .payment-confirmation__field {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs, 0.35rem);
  }

  .payment-confirmation__field label {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.7rem;
    opacity: 0.6;
  }

  .payment-confirmation__input {
    width: 100%;
    color: var(--color-input-text);
    background-color: transparent;
    padding-block: var(--padding-lg, 0.75rem);
    padding-inline: 0;
    border-radius: 0;
    border: none;
    border-bottom: 1px solid var(--color-input-border);
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    -webkit-font-smoothing: antialiased;
    transition: border-color 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .payment-confirmation__input:focus {
    outline: none;
    border-bottom-color: var(--color-foreground);
  }

  .payment-confirmation__input::placeholder {
    color: var(--color-input-text);
    opacity: 0.45;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    text-transform: uppercase;
  }

  .payment-confirmation__input--textarea {
    resize: none;
    min-height: 90px;
    border: 1px solid var(--color-input-border);
    padding: var(--padding-lg, 0.75rem) var(--padding-xl, 1rem);
  }

  .payment-confirmation__input--textarea:focus {
    border-color: var(--color-foreground);
  }

  .payment-confirmation__receipt-note {
    margin: 0;
    font-size: 0.8rem;
    opacity: 0.75;
    line-height: 1.5;
  }

  .payment-confirmation__submit {
    align-self: flex-start;
    cursor: pointer;
  }
{% endstylesheet %}

